/**
 * Job line from reactors to workers.
 *
 * A `thread::channel` wakes on every take too, which with idle workers
 * is a wakeup to find nothing, on the lock the reactor needs next. This
 * one signals only when someone is actually asleep, never from `recv`.
 *
 * Jobs sit behind a spinlock: every critical section is a few moves, and
 * a mutex under contention parks you in the kernel. Sleeping is a futex
 * on an epoch word for the same reason. An empty `recv` spins a moment
 * first; under load that saves two syscalls per job.
 *
 * `oldestWait` is how a reactor tells "behind" from "just read a burst".
 */

use std::thread;
use std::time;

namespace http;

// workers spinning at once, and for how long each spins before it sleeps
internal const int32 MAX_SPINNERS = 2;
internal const int64 SPIN_MICROS = 50;

// spins on a held spinlock before yielding the core
internal const int32 LOCK_SPINS = 256;

internal struct Pending
{
    // newly queued jobs, newest last
    internal array<Job> $jobs;

    // when each job in `$jobs` was queued, index for index
    internal array<time::instant> $since;

    // jobs `recv` takes from, oldest last, so a take is a pop
    // refilled from `$jobs` in reverse once it runs dry
    internal array<Job> $ready;
    internal array<time::instant> $readySince;
}

#[atomic]
internal class JobQueue
{
    // touched only while `$busy` is held
    private Pending $pending;
    private atomic<bool> $busy;

    // jobs queued, beside the lock, so a spinning worker can watch it
    // without taking the lock every sender needs
    private atomic<int32> $count;

    // workers asleep in `recv`, and workers spinning in it
    private atomic<int32> $sleepers;
    private atomic<int32> $spinning;
    private atomic<bool> $closed;

    // what sleepers wait on: bumped before every wake, so a worker that
    // read it before a job came sleeps not at all. one word of its own,
    // since the kernel needs its address
    private ptr<int32> $epoch;

    internal constructor()
    {
        $this->pending = Pending(array<Job>(), array<time::instant>(), array<Job>(), array<time::instant>());
        $this->busy = atomic<bool>(false);
        $this->count = atomic<int32>(0);
        $this->sleepers = atomic<int32>(0);
        $this->spinning = atomic<int32>(0);
        $this->closed = atomic<bool>(false);
        $this->epoch:$ = mem::alloc<int32>(1);
        $this->epoch:$[0] = 0;
    }

    destructor()
    {
        mem::free($this->epoch);
    }

    /**
     * Queue `$job`. Never refused: the server closes only after reactors
     * stop sending.
     */
    internal function send(mv Job $job) : void
    {
        // read the clock before the lock, which every reactor and worker contends for
        time::instant $now = time::instant::now();

        $this->acquire();
        $this->pending->jobs[] = mv $job;
        $this->pending->since[] = $now;
        $this->count->add(1);
        $this->release();

        // a spinning worker takes it. if one takes it and more are left,
        // that worker passes the wake on
        if ($this->spinning->load() == 0) {
            $this->wakeOne();
        }
    }

    /**
     * Next job, blocking. Nothing once closed and empty.
     */
    internal function recv() : Job?
    {
        bool $spun = false;

        while (true) {
            if ($this->count->load() > 0) {
                $this->acquire();

                if ($this->pending->ready->empty()) {
                    while (!$this->pending->jobs->empty()) {
                        $this->pending->ready[] = $this->pending->jobs->pop();
                        $this->pending->readySince[] = $this->pending->since->pop();
                    }
                }

                if (!$this->pending->ready->empty()) {
                    $this->pending->readySince->pop();

                    Job $job = $this->pending->ready->pop();
                    int32 $left = $this->count->sub(1) - 1;

                    $this->release();

                    // the sender skipped the wake while someone spun: pass it on
                    if ($left > 0 && $this->spinning->load() == 0) {
                        $this->wakeOne();
                    }

                    return $job;
                }

                $this->release();
                continue;
            }

            if ($this->closed->load()) {
                return null;
            }

            // spin once per empty look, and only a few workers at a time
            if (!$spun && $this->spinning->load() < MAX_SPINNERS) {
                $this->spinning->add(1);
                $this->spin();
                $this->spinning->sub(1);
                $spun = true;
                continue;
            }

            $spun = false;

            // the epoch first, then counted as asleep, then the look. a
            // sender that queues after the look sees this worker and bumps
            // the epoch, and a bump after the read ends the wait before it
            // starts
            int32 $seen = 0;

            unsafe {
                $seen = mem::atomic::load<int32>($this->epoch:$[0]);
            }

            $this->sleepers->add(1);

            if ($this->count->load() == 0 && !$this->closed->load()) {
                http_futex_wait($this->epoch, $seen);
            }

            $this->sleepers->sub(1);
        }
    }

    /**
     * How long the oldest job has waited. Zero if none.
     */
    internal function oldestWait() : time::duration
    {
        time::duration $wait = time::duration::zero();

        $this->acquire();

        usize $ready = $this->pending->readySince->count();

        if ($ready > 0) {
            $wait = $this->pending->readySince[$ready - 1]->elapsed();
        } else if (!$this->pending->since->empty()) {
            $wait = $this->pending->since[0]->elapsed();
        }

        $this->release();
        return $wait;
    }

    /**
     * No more jobs. Workers drain, then `recv` returns nothing.
     */
    internal function close() : void
    {
        $this->closed->store(true);
        $this->bump(1);
    }

    /**
     * Wake one sleeper, if any. Either it still has to look (and sees the
     * job) or the epoch bump ends its wait.
     */
    private function wakeOne() : void
    {
        if ($this->sleepers->load() == 0) {
            return;
        }

        $this->bump(0);
    }

    /**
     * Moves the epoch on and wakes one sleeper on it, or with `$all`, every
     * one.
     */
    private function bump(int32 $all) : void
    {
        // the word lives as long as the queue, and past the constructor
        // every touch of it is atomic
        unsafe {
            mem::atomic::add<int32>($this->epoch:$[0], 1);
        }

        http_futex_wake($this->epoch, $all);
    }

    /**
     * Watch the count outside the lock until a job shows or the spin
     * runs out. Clock is sampled every 64 beats: it costs more than one.
     */
    private function spin() : void
    {
        time::instant $from = time::instant::now();
        time::duration $limit = time::duration::micros(SPIN_MICROS);
        int32 $beat = 0;

        while ($this->count->load() == 0 && !$this->closed->load()) {
            http_cpu_relax();
            $beat = $beat + 1;

            if ($beat == 64) {
                $beat = 0;

                if ($from->elapsed() >= $limit) {
                    return;
                }
            }
        }
    }

    private function acquire() : void
    {
        int32 $spins = 0;

        while (!$this->busy->compare_exchange(false, true)) {
            // wait on a plain load, so failed swaps do not bounce the line
            while ($this->busy->load()) {
                http_cpu_relax();
                $spins = $spins + 1;

                // the holder was likely preempted. let it run
                if ($spins >= LOCK_SPINS) {
                    $spins = 0;
                    thread::yield();
                }
            }
        }
    }

    private function release() : void
    {
        $this->busy->store(false);
    }
}
