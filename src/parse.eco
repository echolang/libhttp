/**
 * HTTP/1.1 bytes in, a Request out.
 *
 * `Framer` holds unread bytes so the reactor never blocks on a client.
 * `parse` is that with no socket, for tests. Leftover bytes stay in the
 * buffer: they are the next request.
 */

use std::time;

namespace http;

/**
 * Per-connection caps, copied off the Server at `listen`.
 */
internal struct Limits
{
    public usize $maxBody = DEFAULT_BODY_CAP;
    public time::duration $headerTimeout = time::duration::secs(HEADER_TIMEOUT_SECS);
    public time::duration $bodyTimeout = time::duration::secs(BODY_TIMEOUT_SECS);
    public time::duration $idleTimeout = time::duration::secs(IDLE_TIMEOUT_SECS);
    public int32 $maxRequests = DEFAULT_MAX_REQUESTS;

    // oldest whole request waiting on a worker; past this, new conns get 503
    public time::duration $queueWait = time::duration::millis(QUEUE_WAIT_MS);

    // websocket: assembled-message cap, and quiet time before a ping
    // a zero interval never pings
    public usize $maxMessage = DEFAULT_MESSAGE_CAP;
    public time::duration $pingInterval = time::duration::secs(PING_INTERVAL_SECS);

    // per-request body cap from the parsed head. null means maxBody for every request
    public function<usize(const Request&)>? $bodyLimit = null;

    /**
     * Body cap for this request: what `bodyLimit` answers for its head,
     * never above maxBody. Just maxBody when there is no callback.
     */
    public const function bodyCap(const Request& $req) : usize
    {
        function<usize(const Request&)> $f = guard $this->bodyLimit else {
            return $this->maxBody;
        }

        usize $asked = $f($req);

        if ($asked < $this->maxBody) {
            return $asked;
        }

        return $this->maxBody;
    }
}

internal struct HeadEnd
{
    public usize $at;
    public usize $sep;
}

/**
 * Earliest blank line in `$raw`, CRLF or bare LF.
 *
 * Earliest matters: a bare-LF head plus a body that contains CRLF CRLF
 * has to stop at the head's. One SIMD pass over LFs; every blank line
 * has one, so we never scan the body.
 */
internal function findHeadEnd(const string& $raw) : HeadEnd?
{
    usize $n = $raw->size();
    usize $i = 0;

    // raw reads: a byte() per byte is a stdlib call each under --optimize module
    ptr<const uint8> $p = $raw->data();
    simd<uint8, 16> $lf = simd::splat<uint8, 16>(CH_LF);

    while ($i + 16 <= $n) {
        uint64 $hits = simd::bitmask(simd::load<uint8, 16>($p:$ + $i) == $lf);

        while ($hits != 0) {
            usize $at = $i + (bits::trailing_zeros($hits) as usize);

            HeadEnd $end = guard blankLineAt($p, $n, $at) else {
                $hits = $hits & ($hits - 1);
                continue;
            }

            return $end;
        }

        $i = $i + 16;
    }

    while ($i < $n) {
        if ($p:$[$i] == CH_LF) {
            HeadEnd $end = guard blankLineAt($p, $n, $i) else {
                $i = $i + 1;
                continue;
            }

            return $end;
        }

        $i = $i + 1;
    }

    return null;
}

/**
 * The blank line this LF belongs to, if it does: LF LF, or CRLF CRLF one
 * byte back.
 */
private function blankLineAt(ptr<const uint8> $p, usize $n, usize $at) : HeadEnd?
{
    if ($at + 1 >= $n) {
        return null;
    }

    uint8 $next = $p:$[$at + 1];

    if ($next == CH_LF) {
        return HeadEnd($at, 2);
    }

    if ($next == CH_CR && $at >= 1 && $at + 2 < $n && $p:$[$at - 1] == CH_CR && $p:$[$at + 2] == CH_LF) {
        return HeadEnd($at - 1, 4);
    }

    return null;
}

/**
 * Grow `$buf` toward `$want`, at most 2x what is already there.
 *
 * A peer that announces a huge body gets a small buffer until the bytes
 * actually show up.
 */
internal function growToward(string& $buf, usize $want) : void
{
    usize $have = $buf->size();
    usize $ahead = $have + GROW_AHEAD;

    if ($have > GROW_AHEAD) {
        $ahead = $have * 2;
    }

    if ($ahead > $want) {
        $ahead = $want;
    }

    if ($buf->capacity() < $ahead) {
        $buf->reserve($ahead);
    }
}

internal function checkVersion(const string& $version) : status<WireError>
{
    if ($version == 'HTTP/1.0' || $version == 'HTTP/1.1') {
        return .ok();
    }

    if ($version->starts('HTTP/')) {
        return .error(.unsupportedVersion);
    }

    return .error(.badRequest);
}

internal function hostOk(const string& $version, const Headers& $headers) : bool
{
    if ($version != 'HTTP/1.1') {
        return true;
    }

    return $headers->countOf('Host') == 1;
}

/**
 * ASCII digits only. `str::int` accepts a sign; Content-Length does not.
 */
private function digitsOnly(const string& $s) : bool
{
    usize $n = $s->size();
    usize $i = 0;

    if ($n == 0) {
        return false;
    }

    while ($i < $n) {
        uint8 $b = $s->byte($i);

        if ($b < CH_ZERO || $b > CH_NINE) {
            return false;
        }

        $i = $i + 1;
    }

    return true;
}

/**
 * How the body ends: Content-Length, or chunked.
 */
internal enum Framing
{
    case length(usize $n);
    case chunked;
}

/**
 * Framing the headers declare.
 *
 * TE plus Content-Length is a 400: two hops would disagree, which is
 * request smuggling. Only `chunked`, last, once. Anything else is 501.
 * HTTP/1.0 has no TE.
 */
internal function framing(const Request& $req) : result<Framing, WireError>
{
    array<string> $tes = $req->headers->all('Transfer-Encoding');

    if ($tes->count() == 0) {
        usize $n = guard bodyLength($req->headers) else ($e) {
            return .error($e);
        }

        return .ok(.length($n));
    }

    if ($req->version != 'HTTP/1.1' || $req->headers->has('Content-Length')) {
        return .error(.badRequest);
    }

    string $chunked = 'chunked';
    usize $codings = 0;
    usize $chunkedAt = 0;
    usize $chunkedSeen = 0;
    usize $i = 0;

    while ($i < $tes->count()) {
        str::parts $parts = str::split($tes[$i], ',');
        usize $pn = $parts->count();
        usize $pi = 0;

        while ($pi < $pn) {
            string::view $coding = str::trim($parts->at($pi));

            $pi = $pi + 1;

            // an empty list element is allowed and means nothing
            if ($coding->size == 0) {
                continue;
            }

            $codings = $codings + 1;

            if (!str::iequals($coding, $chunked->view())) {
                return .error(.unsupportedCoding);
            }

            $chunkedSeen = $chunkedSeen + 1;
            $chunkedAt = $codings;
        }

        $i = $i + 1;
    }

    if ($codings == 0 || $chunkedSeen != 1 || $chunkedAt != $codings) {
        return .error(.badRequest);
    }

    return .ok(.chunked);
}

/**
 * Content-Length when there is no TE, or 0. Several values are fine if
 * they agree; disagree or non-digits is a 400.
 */
internal function bodyLength(const Headers& $headers) : result<usize, WireError>
{
    array<string> $cls = $headers->all('Content-Length');
    usize $n = $cls->count();

    if ($n == 0) {
        return .ok(0);
    }

    bool $have = false;
    int64 $agreed = 0;
    usize $i = 0;

    while ($i < $n) {
        str::parts $parts = str::split($cls[$i], ',');
        usize $pn = $parts->count();
        usize $pi = 0;

        while ($pi < $pn) {
            $piece = str::from(str::trim($parts->at($pi)));

            $pi = $pi + 1;

            if (!digitsOnly($piece)) {
                return .error(.badRequest);
            }

            int64 $v = guard str::int($piece) else {
                return .error(.badRequest);
            }

            if (!$have) {
                $agreed = $v;
                $have = true;
            } else if ($agreed != $v) {
                return .error(.badRequest);
            }
        }

        $i = $i + 1;
    }

    if (!$have) {
        return .error(.badRequest);
    }

    return .ok($agreed as usize);
}

/**
 * True if the client is waiting for a 100 before the body.
 *
 * HTTP/1.0 has no 100, so its Expect is ignored. Only `100-continue`;
 * anything else is 417.
 */
internal function expectation(const Request& $req) : result<bool, WireError>
{
    if ($req->version != 'HTTP/1.1') {
        return .ok(false);
    }

    array<string> $all = $req->headers->all('Expect');
    usize $n = $all->count();

    if ($n == 0) {
        return .ok(false);
    }

    string $want = '100-continue';
    usize $i = 0;

    while ($i < $n) {
        if (!str::iequals(str::trim($all[$i]), $want->view())) {
            return .error(.expectationFailed);
        }

        $i = $i + 1;
    }

    return .ok(true);
}

/**
 * Request line and headers, no blank line, empty body. The caller
 * already knows where the body starts.
 */
internal function parseHead(const string& $head) : result<Request, WireError>
{
    usize $lineEnd = $head->find('\r\n');
    usize $skip = 2;

    if ($lineEnd >= $head->size()) {
        $lineEnd = $head->find('\n');
        $skip = 1;
    }

    if ($lineEnd >= $head->size()) {
        $lineEnd = $head->size();
        $skip = 0;
    }

    $line = $head->sub(0, $lineEnd);
    string $headerBlock = '';

    if ($skip > 0 && $lineEnd + $skip < $head->size()) {
        $headerBlock = $head->sub($lineEnd + $skip, $head->size() - $lineEnd - $skip);
    }

    usize $sp1 = $line->find(' ');

    if ($sp1 >= $line->size()) {
        return .error(.badRequest);
    }

    usize $sp2 = $line->find(' ', $sp1 + 1);

    if ($sp2 >= $line->size()) {
        return .error(.badRequest);
    }

    $methodRaw = $line->sub(0, $sp1);
    $target = $line->sub($sp1 + 1, $sp2 - $sp1 - 1);
    $version = str::from(str::trim($line->sub($sp2 + 1, $line->size() - $sp2 - 1)));

    if ($methodRaw->empty() || $target->empty()) {
        return .error(.badRequest);
    }

    guard checkVersion($version) else ($e) {
        return .error($e);
    }

    string $path = $target;
    string $qs = '';
    usize $qat = $target->find('?');

    if ($qat < $target->size()) {
        $path = $target->sub(0, $qat);
        $qs = $target->sub($qat + 1, $target->size() - $qat - 1);
    }

    if ($path->empty()) {
        $path = '/';
    }

    Headers $headers = guard parseHeaderBlock($headerBlock) else ($e) {
        return .error($e);
    }

    if (!hostOk($version, $headers)) {
        return .error(.badRequest);
    }

    // empty then moved in: the constructor would copy both twice
    Request $req = Request(
        methodOf($methodRaw),
        $target,
        $path,
        $qs,
        Query(),
        $version,
        Headers(),
        '',
        ''
    );
    Query $query = parseQuery($qs);

    $req->headers = mv $headers;
    $req->query = mv $query;

    return .ok($req);
}

/**
 * Keep-alive after this request? HTTP/1.1 yes unless `close`; HTTP/1.0
 * no unless `keep-alive`.
 */
internal function persistent(const Request& $req) : bool
{
    if ($req->version == 'HTTP/1.1') {
        return !hasToken($req->headers, 'Connection', 'close');
    }

    return hasToken($req->headers, 'Connection', 'keep-alive');
}

/**
 * True if any header of this name lists `$token`. Case-insensitive
 * unless `exact`, which a subprotocol name needs.
 */
internal function hasToken(const Headers& $headers, const string& $name, const string& $token, exact: bool $exact = false) : bool
{
    array<string> $all = $headers->all($name);
    usize $n = $all->count();
    usize $i = 0;

    while ($i < $n) {
        str::parts $parts = str::split($all[$i], ',');
        usize $pn = $parts->count();
        usize $pi = 0;

        while ($pi < $pn) {
            if ($exact) {
                if (str::trim($parts->at($pi))->equals($token->view())) {
                    return true;
                }
            } else if (str::iequals(str::trim($parts->at($pi)), $token->view())) {
                return true;
            }

            $pi = $pi + 1;
        }

        $i = $i + 1;
    }

    return false;
}

internal enum Phase
{
    case idle;
    case head;
    case body;
    case chunked;
}

/**
 * What one `advance` found. `sendContinue` means send the 100 and
 * advance again.
 */
internal enum Step
{
    case needMore;
    case sendContinue;

    // the request is whole. `Framer::request()` has it
    case ready;
    case fail(WireError $e);
}

/**
 * Deadline the connection blew. `idle` closes with no answer; `timeout`
 * is a 408.
 */
internal enum Expiry
{
    case none;
    case idle;
    case timeout;
}

/**
 * One connection's request in progress. Append to `$buffer`, call
 * `advance`. No socket, so tests can drive it with a string.
 */
internal struct Framer
{
    public string $buffer;
    private Phase $phase = Phase::idle;

    // parsed head, then the finished request. stays here so the reactor
    // never copies it
    private Request? $pending = null;
    private string $body = '';
    private usize $bodyAt = 0;
    private usize $need = 0;

    // this request's body cap, worked out from its head
    private usize $cap = 0;
    private Dechunk $chunks = Dechunk(0);
    private time::instant $since = time::instant::now();

    public constructor()
    {
        $this->buffer = '';
    }

    /**
     * Start from leftover bytes of the previous request.
     */
    public constructor(const string& $rest)
    {
        $this->buffer = $rest;
    }

    public function advance(const Limits& $limits) : Step
    {
        Phase $at = $this->phase;

        return match ($at) {
            Phase::idle => $this->start($limits),
            Phase::head => $this->head($limits),
            Phase::body => $this->body(),
            Phase::chunked => $this->chunkedBody(),
        };
    }

    /**
     * The request the last `ready` finished, body included.
     */
    public const function request() : Request?
    {
        Request $req = guard $this->pending else {
            return null;
        }

        $req->body = $this->body;
        return $req;
    }

    /**
     * Deadline for the phase this connection is in, if it blew it.
     */
    public const function expired(const Limits& $limits) : Expiry
    {
        time::duration $age = $this->since->elapsed();
        Phase $at = $this->phase;
        time::duration $cap = match ($at) {
            Phase::idle => $limits->idleTimeout,
            Phase::head => $limits->headerTimeout,
            else => $limits->bodyTimeout,
        };

        if ($age < $cap) {
            return .none;
        }

        return match ($at) {
            Phase::idle => Expiry::idle,
            else => Expiry::timeout,
        };
    }

    private function start(const Limits& $limits) : Step
    {
        $this->skipBlankLines();

        if ($this->buffer->empty()) {
            return .needMore;
        }

        $this->phase = Phase::head;
        $this->since = time::instant::now();
        return $this->head($limits);
    }

    /**
     * Drop empty lines before a request line. Some clients trail a body
     * with an extra CRLF. A lone CR waits for its LF.
     */
    private function skipBlankLines() : void
    {
        usize $n = $this->buffer->size();
        usize $skip = 0;

        while ($skip < $n) {
            uint8 $b = $this->buffer->byte($skip);

            if ($b == CH_LF) {
                $skip = $skip + 1;
            } else if ($b == CH_CR && $skip + 1 < $n && $this->buffer->byte($skip + 1) == CH_LF) {
                $skip = $skip + 2;
            } else {
                break;
            }
        }

        if ($skip > 0) {
            $this->buffer = $this->buffer->sub($skip, $n - $skip);
        }
    }

    private function head(const Limits& $limits) : Step
    {
        HeadEnd $end = guard findHeadEnd($this->buffer) else {
            if ($this->buffer->size() >= HEADER_CAP) {
                return .fail(.tooLarge);
            }

            return .needMore;
        }

        if ($end->at + $end->sep > HEADER_CAP) {
            return .fail(.tooLarge);
        }

        // answer a bad head before reading a byte of body
        Request $req = guard parseHead($this->buffer->sub(0, $end->at)) else ($e) {
            return .fail($e);
        }

        Framing $framing = guard framing($req) else ($e) {
            return .fail($e);
        }

        bool $wantsContinue = guard expectation($req) else ($e) {
            return .fail($e);
        }

        // the head is good: the server picks this request's cap before any body
        $this->cap = $limits->bodyCap($req);
        $this->bodyAt = $end->at + $end->sep;

        bool $isChunked = match ($framing) {
            Framing::chunked => true,
            else => false,
        };

        if ($isChunked) {
            $this->chunks = Dechunk($this->bodyAt);
            $this->pending = mv $req;
            $this->phase = Phase::chunked;
            $this->since = time::instant::now();

            if ($wantsContinue && $this->buffer->size() == $this->bodyAt) {
                return .sendContinue;
            }

            return $this->chunkedBody();
        }

        usize $need = match ($framing) {
            Framing::length($n) => $n,
            else => 0,
        };

        // 413 answers Expect too, so this is before the 100
        if ($need > $this->cap) {
            return .fail(.tooLarge);
        }

        $this->need = $need;
        $this->pending = mv $req;
        $this->phase = Phase::body;
        $this->since = time::instant::now();

        usize $want = $this->bodyAt + $need;

        if ($this->buffer->size() < $want) {
            growToward($this->buffer, $want);

            if ($wantsContinue && $need > 0) {
                return .sendContinue;
            }
        }

        return $this->body();
    }

    private function body() : Step
    {
        usize $want = $this->bodyAt + $this->need;

        if ($this->buffer->size() < $want) {
            growToward($this->buffer, $want);
            return .needMore;
        }

        if ($this->pending == null) {
            return .fail(.badRequest);
        }

        $this->body = $this->buffer->sub($this->bodyAt, $this->need);
        $this->buffer = $this->buffer->sub($want, $this->buffer->size() - $want);
        $this->phase = Phase::idle;
        $this->since = time::instant::now();
        return .ready;
    }

    private function chunkedBody() : Step
    {
        Chunking $c = $this->chunks->feed($this->buffer, $this->cap);

        match ($c) {
            Chunking::needMore => {
                return .needMore;
            },
            Chunking::fail($e) => {
                return .fail($e);
            },
            Chunking::done => {
            },
        }

        if ($this->pending == null) {
            return .fail(.badRequest);
        }

        $this->body = $this->chunks->body;
        $this->chunks = Dechunk(0);
        $this->phase = Phase::idle;
        $this->since = time::instant::now();
        return .ready;
    }
}

internal function parse(const string& $raw) : result<Request, WireError>
{
    Framer $f = Framer($raw);
    Limits $limits = Limits();

    $limits->maxBody = std::math::MAX_USIZE;

    Step $s = $f->advance($limits);
    bool $again = match ($s) {
        Step::sendContinue => true,
        else => false,
    };

    if ($again) {
        $s = $f->advance($limits);
    }

    match ($s) {
        Step::ready => {
            Request $req = guard $f->request() else {
                return .error(.badRequest);
            }

            return .ok($req);
        },
        Step::fail($e) => {
            return .error($e);
        },
        else => {
            return .error(.badRequest);
        },
    }
}
