/**
 * A complete request in, a response out, the connection back or closed.
 * The same for a websocket: one whole message in, the hook run, the socket
 * back to the reactor.
 *
 * A worker never waits on a client that is still sending. Writes still
 * block under the 10 second send timeout.
 */

use std::thread;
use std::time;

namespace http;

/**
 * One complete request and the connection it came in on: the reactor's
 * whole slot, moved rather than copied. Its Framer holds the request, and
 * its buffer the bytes past it, the start of the next one when pipelined.
 */
internal struct Visit
{
    public int32 $fd;

    // which reactor the connection goes back to
    public int32 $home;
    public Slot $slot;
}

/**
 * A kept connection on its way back to the reactor.
 */
internal struct Parked
{
    public int32 $fd;
    public string $peer;
    public string $rest;
    public int32 $served;
}

/**
 * A connection on its way back to the reactor: a kept HTTP one, an open
 * websocket, or one whose last response is out and whose write side is
 * shut, for the reactor to drain until the client hangs up.
 */
internal enum Back
{
    case kept(Parked $p);
    case socket(WsConn $ws);
    case linger(int32 $fd);
}

internal enum Job
{
    case serve(Visit $visit);

    // the reactor could not make a request of the bytes: answer, then close.
    // `$home` is the reactor that lingers on the close
    case fail(int32 $fd, int32 $home, WireError $e);

    // something for an open websocket's worker to do
    case ws(WsConn $ws, WsEvent $event);
}

/**
 * What the reactors and every worker share. `#[atomic]` because all of them
 * hold it.
 */
#[atomic]
internal class Shared
{
    // connections open anywhere: idle, being read, or on a worker
    public atomic<int32> $live;
    public atomic<bool> $stopping;

    // websockets opened so far, which is where a Socket's id comes from
    public atomic<int64> $sockets;

    public constructor()
    {
        $this->live = atomic<int32>(0);
        $this->stopping = atomic<bool>(false);
        $this->sockets = atomic<int64>(0);
    }
}

/**
 * Where a worker hands a connection back: one reactor's return channel, and
 * the pipe that wakes it.
 */
internal struct Home
{
    public thread::sender<Back> $back;
    public int32 $wake;

    /**
     * Sends `$b` home and wakes the reactor. False when that reactor is
     * gone; `$b` is then dropped with this call.
     */
    public function hand(Back $b) : bool
    {
        if (!$this->back->send($b)) {
            return false;
        }

        http_wake($this->wake);
        return true;
    }
}

/**
 * Writes one response and ends the connection, which `linger` closes.
 */
internal function respond(Conn& $conn, const Response& $res, bool $sendBody, array<Home>& $homes, int32 $home, Shared $shared) : void
{
    $conn->writeAll(render($res, $sendBody));
    linger($conn, $homes, $home, $shared);
}

/**
 * Ends a connection after its last response with a lingering close, so a
 * client still sending (a 413 body, a pipelined request) reads the answer
 * instead of a reset. The write side shuts here and the reactor drains the
 * rest, so the worker never waits on the client. The connection counts as
 * live until the reactor closes it.
 */
internal function linger(Conn& $conn, array<Home>& $homes, int32 $home, Shared $shared) : void
{
    lingerOn($conn->release(), $homes, $home, $shared);
}

/**
 * `linger` for a bare descriptor this worker owns. A server that is stopping
 * may have no reactor left to drain it, and `listen` waits on the workers
 * anyway, so the worker lingers itself then.
 */
internal function lingerOn(int32 $fd, array<Home>& $homes, int32 $home, Shared $shared) : void
{
    if ($fd < 0) {
        $shared->live->sub(1);
        return;
    }

    if ($shared->stopping->load()) {
        http_finish($fd);
        $shared->live->sub(1);
        return;
    }

    // the client is gone already: nothing to drain
    if (http_shut_write($fd) != 0) {
        http_close($fd);
        $shared->live->sub(1);
        return;
    }

    if (!$homes[$home]->hand(Back::linger($fd))) {
        // no reactor to take it: linger here, the one time a worker waits
        http_finish($fd);
        $shared->live->sub(1);
    }
}

/**
 * The route table as a handler: match, 404 or 405 with `Allow`, params, then
 * the route's own handler.
 */
internal function dispatch(const Router& $router, Request $req) : Response
{
    array<string> $path = segments($req->path);

    usize $at = guard $router->find($req->method, $path) else {
        string $allow = $router->allow($path);

        if ($allow->empty()) {
            return .notFound();
        }

        Response $r = errorResponse(405, 'Method Not Allowed');

        $r->headers->set('Allow', $allow);
        return $r;
    }

    applyParams($req, $router->routes[$at], $path);

    Response $res = $router->routes[$at]->handler($req);

    // the Socket keeps the request as the handler saw it, params and all
    if ($res->upgrades()) {
        $res->origin = $req;
    }

    return $res;
}

/**
 * What this response tells the client about the connection. Kept only when
 * the client asked, the connection has requests left, and the server is not
 * stopping.
 */
internal function persistFor(const Request& $req, int32 $served, const Limits& $limits, const Shared& $shared) : Persist
{
    if (!persistent($req)) {
        return .close;
    }

    if ($served + 1 >= $limits->maxRequests) {
        return .close;
    }

    if ($shared->stopping->load()) {
        return .close;
    }

    if ($req->version == 'HTTP/1.1') {
        return .keep;
    }

    return .keepAlive($limits->idleTimeout->as_secs());
}

internal function closes(const Persist& $p) : bool
{
    return match ($p) {
        Persist::close => true,
        else => false,
    };
}

/**
 * Sends a streamed response: the head, then the callback through a Writer.
 * A length is Content-Length. No length over HTTP/1.1 is chunked. HEAD,
 * or a status with no body, never runs the stream.
 */
internal function streamTo(Conn $conn, const Response& $res, bool $head, bool $http11, const Persist& $persist, Shared $shared) : bool
{
    bool $sendBody = !$head && !bodyless($res->status);
    Length $length = Length::none;
    Mode $mode = Mode::raw;
    uint64 $size = 0;

    if ($res->length >= 0) {
        $size = $res->length as uint64;
        $length = Length::exact($res->length as usize);
        $mode = Mode::sized;
    } else if ($sendBody && $http11) {
        $length = Length::chunked;
        $mode = Mode::chunked;
    }

    if (!$conn->writeAll(renderHead($res, $length, $persist))) {
        return false;
    }

    if (!$sendBody) {
        return true;
    }

    function<void(Writer)> $fn = guard $res->stream else {
        return $size == 0;
    }

    Writer $w = Writer($conn, $shared, $mode, $size);

    $fn($w);
    return $w->finish();
}

internal function serveVisit(const Visit& $visit, array<Home>& $homes, function<Response(Request)> $app, const Limits& $limits, Shared $shared) : void
{
    Conn $conn = Conn($visit->fd);

    // the reactor only hands over a slot whose Framer said ready
    Request $req = guard $visit->slot->framer->request() else {
        $shared->live->sub(1);
        return;
    }

    $req->peer = $visit->slot->peer;

    Response $res = $app($req);

    if ($res->upgrades()) {
        upgrade($conn, $visit, $req, $res, $homes, $shared);
        return;
    }

    bool $head = methodEq($req->method, Method::head);
    bool $http11 = $req->version == 'HTTP/1.1';
    Persist $persist = persistFor($req, $visit->slot->served, $limits, $shared);
    bool $whole = false;

    if ($res->streamed()) {
        // an HTTP/1.0 client can only read the end of an unsized body as the close
        if (!$http11 && !$head && $res->length < 0 && !bodyless($res->status)) {
            $persist = Persist::close;
        }

        $whole = streamTo($conn, $res, $head, $http11, $persist, $shared);
    } else {
        $whole = $conn->writeAll(render($res, !$head, $persist));
    }

    if (!$whole) {
        // the client is gone, or the body fell short: the conn closes on drop
        $shared->live->sub(1);
        return;
    }

    if (closes($persist) || $shared->stopping->load()) {
        linger($conn, $homes, $visit->home, $shared);
        return;
    }

    int32 $fd = $conn->release();
    Parked $parked = Parked($fd, $visit->slot->peer, $visit->slot->framer->buffer, $visit->slot->served + 1);

    if (!$homes[$visit->home]->hand(Back::kept($parked))) {
        http_close($fd);
        $shared->live->sub(1);
    }
}

internal function workerLoop(JobQueue $jobs, array<Home> $homes, function<Response(Request)> $app, Limits $limits, Shared $shared) : void
{
    while (true) {
        Job $job = guard $jobs->recv() else {
            return;
        }

        match ($job) {
            Job::serve($visit) => {
                serveVisit($visit, $homes, $app, $limits, $shared);
            },
            Job::fail($fd, $home, $e) => {
                Conn $conn = Conn($fd);

                respond($conn, errorResponse($e->status(), $e->body()), true, $homes, $home, $shared);
            },
            Job::ws($ws, $event) => {
                serveSocket($ws, $event, $homes, $shared);
            },
        }
    }
}

/**
 * Answers a websocket response: the 101, `onOpen`, and the socket handed to
 * the reactor. A request that is not a valid upgrade gets its 426 or 400 and
 * the connection closes, with no hook run.
 */
internal function upgrade(Conn $conn, const Visit& $visit, const Request& $asked, const Response& $res, array<Home>& $homes, Shared $shared) : void
{
    Request $req = $res->origin ?? $asked;
    result<string, UpgradeError> $checked = upgradeKey($req);

    string $key = guard $checked else ($e) {
        respond($conn, refusal($e), !methodEq($req->method, Method::head), $homes, $visit->home, $shared);
        return;
    }

    // serveVisit only calls this for a response that upgrades
    Upgrade $to = guard $res->upgrade;
    Channel $channel = $to->channel;
    string $protocol = '';

    // a client must fail a handshake that names a subprotocol it did not offer
    if (hasToken($req->headers, 'Sec-WebSocket-Protocol', $to->protocol, exact: true)) {
        $protocol = $to->protocol;
    }

    if (!$conn->writeAll(renderHead(switching($res, $key, $protocol), Length::none, Persist::upgrade))) {
        $shared->live->sub(1);
        return;
    }

    int32 $fd = $conn->release();
    Socket $socket = Socket($fd, $req, $protocol, $shared);
    WsConn $ws = WsConn($fd, $visit->home, $socket, $channel, Reader(true, $visit->slot->framer->buffer), time::instant::now(), false, null);

    $channel->runOpen($socket);
    park($ws, $homes, $shared);
}

/**
 * One thing done for an open websocket, then the socket back to the reactor,
 * unless it ended.
 */
internal function serveSocket(WsConn $ws, WsEvent $event, array<Home>& $homes, Shared $shared) : void
{
    Socket $s = $ws->socket;

    match ($event) {
        WsEvent::message($m) => {
            // once a close went out, what the client still sends is read and dropped
            if (!$s->closing()) {
                $ws->channel->runMessage($s, $m);
            }
        },
        WsEvent::ping($payload) => {
            $s->frame(OP_PONG, $payload);
        },
        WsEvent::keepalive => {
            $s->frame(OP_PING, '');
        },
        WsEvent::close($code, $reason) => {
            // the answer to the client's close, unless this was the answer to ours
            $s->shut($code, '');
            finishClose($ws, Close($code, $reason, true), $homes, $shared);
            return;
        },
        WsEvent::fail($code) => {
            $s->shut($code, '');
            finishClose($ws, Close($code, '', false), $homes, $shared);
            return;
        },
        WsEvent::gone => {
            // gone includes a peer still connected that went quiet or never answered our close
            finishClose($ws, Close(CLOSE_ABNORMAL, '', false), $homes, $shared);
            return;
        },
        WsEvent::goingAway => {
            goAway($ws, $shared);
            return;
        },
    }

    park($ws, $homes, $shared);
}

/**
 * Hands an open socket back to the reactor. A server that is stopping gets
 * a 1001 instead: the reactor may already have stopped taking sockets back.
 */
internal function park(WsConn $ws, array<Home>& $homes, Shared $shared) : void
{
    if ($shared->stopping->load()) {
        goAway($ws, $shared);
        return;
    }

    // the failed send dropped its copy; this one still owns the socket
    if (!$homes[$ws->home]->hand(Back::socket($ws))) {
        end($ws, Close(CLOSE_ABNORMAL, '', false), $shared);
    }
}

/**
 * Closes a socket because the server is stopping.
 */
internal function goAway(WsConn $ws, Shared $shared) : void
{
    $ws->socket->shut(CLOSE_GOING_AWAY, 'server stopping');
    end($ws, Close(CLOSE_GOING_AWAY, '', false), $shared);
}

/**
 * The end of a socket whose close frame went out: the reactor lingers on
 * the connection while the client finishes its side, then `onClose`, once.
 */
internal function finishClose(WsConn $ws, Close $c, array<Home>& $homes, Shared $shared) : void
{
    lingerOn($ws->socket->take(), $homes, $ws->home, $shared);
    $ws->channel->runClose($ws->socket, $c);
}

/**
 * The end of a socket: the connection closed, then `onClose`, once.
 */
internal function end(WsConn $ws, Close $c, Shared $shared) : void
{
    $ws->socket->release();
    $shared->live->sub(1);
    $ws->channel->runClose($ws->socket, $c);
}
