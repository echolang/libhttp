/**
 * Route table, listen socket, reactors, worker pool.
 *
 * `#[atomic]` because workers copy the handle. Routes snapshot at
 * `listen`. The first reactor runs on the calling thread; `listen`
 * returns the bound port after `stop()`.
 *
 * Workers only see whole requests. Idle connections stay on the
 * reactor that accepted them. A dying handler kills the process.
 */

use std::thread;
use std::time;

namespace http;

internal function joinAll(array<thread::handle>& $workers) : void
{
    usize $n = $workers->count();
    usize $i = 0;

    while ($i < $n) {
        $workers[$i]->join();
        $i = $i + 1;
    }
}

internal function wakeAll(const array<int32>& $fds) : void
{
    usize $n = $fds->count();
    usize $i = 0;

    while ($i < $n) {
        http_wake($fds[$i]);
        $i = $i + 1;
    }
}

internal function closeAll(array<int32>& $fds) : void
{
    usize $n = $fds->count();
    usize $i = 0;

    while ($i < $n) {
        http_close($fds[$i]);
        $i = $i + 1;
    }

    $fds->clear();
}

/**
 * Reactor count: `$asked`, or one per four workers if zero. At least
 * one, never more than workers.
 */
internal function reactorsFor(int32 $asked, int32 $workers) : int32
{
    int32 $n = $asked;

    if ($n < 1) {
        $n = ($workers + 3) / 4;
    }

    if ($n > $workers) {
        $n = $workers;
    }

    if ($n < 1) {
        $n = 1;
    }

    return $n;
}

/**
 * Keep the first reactor error. Later ones are the same broken listen.
 */
internal function failWith(thread::mutex<Error?> $failed, Error $e) : void
{
    thread::locked<Error?> $held = $failed->lock();

    if ($held->value == null) {
        $held->value = $e;
    }
}

/**
 * One reactor's run. A broken listen stops the others too.
 */
internal function runReactor(
    int32 $ev,
    int32 $listenFd,
    int32 $wakeRd,
    int32 $home,
    int32 $batch,
    Limits $limits,
    int32 $maxConns,
    Shared $shared,
    JobQueue $jobs,
    thread::receiver<Back> $back,
    Inbox $inbox,
    array<int32> $wakes,
    thread::mutex<Error?> $failed
) : void
{
    Reactor $reactor = Reactor($ev, $listenFd, $wakeRd, $home, $batch, $limits, $maxConns, $shared, $jobs, $back, $inbox);
    status<Error> $ran = $reactor->run();

    if ($ran->failed()) {
        failWith($failed, $ran->failure());
        $shared->stopping->store(true);
        wakeAll($wakes);
    }

    $reactor->shutdown();
}

#[atomic]
public class Server
{
    private array<Route> $routes;
    private array<function<Response(Request, Next)>> $layers;
    private int32 $workerCount;

    // zero means one reactor per four workers, worked out at listen
    private int32 $reactorCount;

    // what each connection may cost, copied to the reactors and workers at listen
    // changing a setter afterwards does not touch a running server
    private Limits $limits;
    private int32 $connCap;
    private int32 $listenFd;

    // one event set and one wake pipe per reactor
    private array<int32> $evFds;
    private array<int32> $wakeReads;

    // the wake pipes' write ends, behind a lock so stop() never writes to
    // an fd release() has closed and the process has handed to someone else
    private thread::mutex<array<int32>> $wakeWrites;

    // what the running listen shares with its reactors and workers.
    // swapped under the wakeWrites lock, which is also where stop() reads it
    private Shared $shared;
    private atomic<int32> $boundPort;

    // a stop() that found no listen to wake, kept for the next one to see
    // read and written under the wakeWrites lock
    private atomic<bool> $stopAsked;

    public constructor()
    {
        $this->routes = array<Route>();
        $this->layers = array<function<Response(Request, Next)>>();

        int32 $workers = std::thread::concurrency() as int32;

        if ($workers < 1) {
            $workers = 1;
        }

        $this->workerCount = $workers;
        $this->reactorCount = 0;
        $this->limits = Limits();
        $this->connCap = DEFAULT_MAX_CONNECTIONS;
        $this->listenFd = -1;
        $this->evFds = array<int32>();
        $this->wakeReads = array<int32>();
        $this->wakeWrites = thread::mutex<array<int32>>(array<int32>());
        $this->shared = Shared();
        $this->boundPort = atomic<int32>(0);
        $this->stopAsked = atomic<bool>(false);
    }

    destructor()
    {
        $this->release();
    }

    public function workers(int32 $n) : void
    {
        $this->workerCount = $n;
    }

    public const function workers() : int32
    {
        return $this->workerCount;
    }

    /**
     * Reactor threads. Zero is one per four workers, capped at worker count.
     */
    public function reactors(int32 $n) : void
    {
        if ($n < 0) {
            $n = 0;
        }

        $this->reactorCount = $n;
    }

    /**
     * How many reactors `listen` will actually run.
     */
    public const function reactors() : int32
    {
        return reactorsFor($this->reactorCount, $this->workerCount);
    }

    public function maxBody(usize $n) : void
    {
        $this->limits->maxBody = $n;
    }

    /**
     * Pick the body cap per request. `$f` sees the parsed head (method,
     * path, query, headers; the body is still empty) and returns the cap
     * for that request. The cap is the smaller of that and maxBody.
     *
     * It runs on the reactor before a byte of body is read, so a 413
     * still comes before the 100. Keep it quick: the reactor waits on it.
     */
    public function bodyLimit(function<usize(const Request&)> $f) : void
    {
        $this->limits->bodyLimit = $f;
    }

    /**
     * Time to finish the request line and headers. 408 after that.
     */
    public function headerTimeout(time::duration $d) : void
    {
        $this->limits->headerTimeout = $d;
    }

    /**
     * Time to finish the body once the head is in. 408 after that.
     */
    public function bodyTimeout(time::duration $d) : void
    {
        $this->limits->bodyTimeout = $d;
    }

    /**
     * Idle time between requests, and until the first byte of a new
     * connection.
     */
    public function idleTimeout(time::duration $d) : void
    {
        $this->limits->idleTimeout = $d;
    }

    /**
     * Requests one connection may make before it is closed.
     */
    public function maxRequests(int32 $n) : void
    {
        if ($n < 1) {
            $n = 1;
        }

        $this->limits->maxRequests = $n;
    }

    /**
     * Open connections, idle included. Past it, new ones get 503. Each is
     * an fd, so this sits under `ulimit -n`.
     */
    public function maxConnections(int32 $n) : void
    {
        if ($n < 1) {
            $n = 1;
        }

        $this->connCap = $n;
    }

    /**
     * How long the oldest queued request may wait before new connections
     * get 503.
     */
    public function maxQueueWait(time::duration $d) : void
    {
        if ($d < time::duration::millis(1)) {
            $d = time::duration::millis(1);
        }

        $this->limits->queueWait = $d;
    }

    /**
     * Largest assembled websocket message. Past it, 1009, decided from
     * the frame header.
     */
    public function maxMessage(usize $n) : void
    {
        $this->limits->maxMessage = $n;
    }

    /**
     * Quiet time before a websocket ping. Another interval of silence
     * closes it with 1006. Zero never pings.
     */
    public function pingInterval(time::duration $d) : void
    {
        $this->limits->pingInterval = $d;
    }

    /**
     * Bound port of the running `listen`, or 0.
     */
    public const function port() : int32
    {
        return $this->boundPort->load();
    }

    /**
     * Register a route. The verb methods call this.
     */
    public function on(Method $method, const string& $path, function<Response(Request)> $handler) : void
    {
        $this->routes[] = Route($method, $path, $handler);
    }

    /**
     * Run `$mw` around every request, before routing. First registered
     * is outermost. Skip `$next->run` to answer yourself.
     */
    public function wrap(function<Response(Request, Next)> $mw) : void
    {
        $this->layers[] = $mw;
    }

    public function get(const string& $path, function<Response(Request)> $handler) : void
    {
        $this->on(Method::get, $path, $handler);
    }

    public function post(const string& $path, function<Response(Request)> $handler) : void
    {
        $this->on(Method::post, $path, $handler);
    }

    public function put(const string& $path, function<Response(Request)> $handler) : void
    {
        $this->on(Method::put, $path, $handler);
    }

    public function patch(const string& $path, function<Response(Request)> $handler) : void
    {
        $this->on(Method::patch, $path, $handler);
    }

    public function del(const string& $path, function<Response(Request)> $handler) : void
    {
        $this->on(Method::delete, $path, $handler);
    }

    public function head(const string& $path, function<Response(Request)> $handler) : void
    {
        $this->on(Method::head, $path, $handler);
    }

    public function options(const string& $path, function<Response(Request)> $handler) : void
    {
        $this->on(Method::options, $path, $handler);
    }

    /**
     * Websocket at `$path`. Non-upgrade GETs get 426. For per-request
     * choice, return `Response(websocket:)` from your own GET.
     */
    public function ws(const string& $path, Channel $channel) : void
    {
        $this->on(Method::get, $path, function(Request $req) : Response {
            return Response(websocket: $channel);
        });
    }

    /**
     * Unblock `listen`, from any thread. Idle conns close now; in-flight
     * requests finish. A stop before listen is kept for the next one.
     */
    public function stop() : void
    {
        thread::locked<array<int32>> $wr = $this->wakeWrites->lock();

        $this->stopAsked->store(true);

        if (!$wr->value->empty()) {
            $this->shared->stopping->store(true);
            wakeAll($wr->value);
        }
    }

    /**
     * Bind `$host`:`$port` and serve until `stop()`. Port 0 is ephemeral.
     * Returns the bound port.
     */
    public function listen(const string& $host, int32 $port) : result<int32, Error>
    {
        if ($port < 0 || $port > 65535) {
            return .error(.badPort);
        }

        if ($this->workerCount < 1) {
            return .error(.tooFewWorkers);
        }

        $name = cstrOf($host);
        int32 $listenFd = http_listen($name->cstr(), $port);

        if ($listenFd < 0) {
            return .error(.bind(lastError()));
        }

        int32 $bound = http_port($listenFd);

        if ($bound < 0) {
            http_close($listenFd);
            return .error(.bind(lastError()));
        }

        int32 $count = reactorsFor($this->reactorCount, $this->workerCount);
        array<int32> $evs = array<int32>();
        array<int32> $rds = array<int32>();
        array<int32> $wrs = array<int32>();

        // one way back to each reactor, unbounded so a worker never blocks on it
        array<Home> $homes = array<Home>();
        array<thread::receiver<Back>> $backs = array<thread::receiver<Back>>();
        int32 $k = 0;

        while ($k < $count) {
            int32 $ev = http_ev_open();
            int32 $rd = -1;
            int32 $wr = -1;

            if ($ev < 0 || http_pipe_open(&$rd, &$wr) != 0) {
                Error $opened = .bind(lastError());

                if ($ev >= 0) {
                    http_close($ev);
                }

                closeAll($evs);
                closeAll($rds);
                closeAll($wrs);
                http_close($listenFd);
                return .error($opened);
            }

            $evs[] = $ev;
            $rds[] = $rd;
            $wrs[] = $wr;

            thread::channel<Back> $returns = thread::channel<Back>();

            $homes[] = Home($returns->tx(), $wr, $ev, Inbox());
            $backs[] = $returns->rx();
            $k = $k + 1;
        }

        Shared $shared = Shared();

        $this->listenFd = $listenFd;
        $this->evFds = $evs;
        $this->wakeReads = $rds;
        {
            thread::locked<array<int32>> $held = $this->wakeWrites->lock();

            $held->value = $wrs;
            $this->shared = $shared;

            // stop() ran before there was a pipe to wake. the reactors see it first thing
            if ($this->stopAsked->load()) {
                $shared->stopping->store(true);
                wakeAll($wrs);
            }
        }

        $this->boundPort->store($bound);

        array<Route> $table = $this->routes;
        Router $router = Router(mv $table);
        Limits $limits = $this->limits;
        int32 $maxConns = $this->connCap;

        function<Response(Request)> $app = chain($this->layers, function(Request $req) : Response {
            return dispatch($router, $req);
        });

        // one line of jobs for every reactor, so any free worker takes any request
        JobQueue $jobs = JobQueue();

        array<thread::handle> $workers = array<thread::handle>();
        int32 $n = $this->workerCount;
        int32 $i = 0;

        while ($i < $n) {
            result<thread::handle, thread::error> $started = thread::spawn(function() : void {
                workerLoop($jobs, $homes, $app, $limits, $shared);
            });

            thread::handle $w = guard $started else ($e) {
                $jobs->close();
                joinAll($workers);
                $this->release();
                return .error(.spawn($e->message()));
            }

            $workers[] = $w;
            $i = $i + 1;
        }

        // an opening burst of connections spreads over the reactors rather
        // than all landing on one
        int32 $batch = ACCEPT_BATCH / $count;

        if ($batch < 1) {
            $batch = 1;
        }

        thread::mutex<Error?> $failed = thread::mutex<Error?>(null);
        array<thread::handle> $others = array<thread::handle>();

        $k = 1;

        while ($k < $count) {
            int32 $at = $k;
            result<thread::handle, thread::error> $spawned = thread::spawn(function() : void {
                runReactor($evs[$at], $listenFd, $rds[$at], $at, $batch, $limits, $maxConns, $shared, $jobs, $backs[$at], $homes[$at]->inbox, $wrs, $failed);
            });

            if ($spawned->failed()) {
                // reactors already running stop the usual way, and so does the first
                failWith($failed, .spawn($spawned->failure()->message()));
                $shared->stopping->store(true);
                wakeAll($wrs);
                break;
            }

            $others[] = $spawned->unwrap();
            $k = $k + 1;
        }

        runReactor($evs[0], $listenFd, $rds[0], 0, $batch, $limits, $maxConns, $shared, $jobs, $backs[0], $homes[0]->inbox, $wrs, $failed);
        joinAll($others);

        // no reactor sends any more. workers finish what is queued, then return
        $jobs->close();
        joinAll($workers);

        $k = 0;

        while ($k < $count) {
            drainReturned($backs[$k], $homes[$k]->inbox, $shared);
            $k = $k + 1;
        }

        $this->release();

        Error? $first = null;

        {
            thread::locked<Error?> $held = $failed->lock();

            $first = $held->value;
        }

        Error $e = guard $first else {
            return .ok($bound);
        }

        return .error($e);
    }

    private function release() : void
    {
        if ($this->listenFd >= 0) {
            http_close($this->listenFd);
            $this->listenFd = -1;
        }

        closeAll($this->evFds);
        closeAll($this->wakeReads);

        thread::locked<array<int32>> $wr = $this->wakeWrites->lock();

        closeAll($wr->value);
        $this->stopAsked->store(false);
        $this->boundPort->store(0);
    }
}
