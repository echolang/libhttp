/**
 * What the handler sends back.
 *
 * Public fields. Labelled constructors for the common 200s; `notFound`
 * and friends are statics so `return .notFound()` works. A stream is a
 * callback through a `Writer` and holds the worker until it returns.
 * The serializer owns Content-Length and Connection.
 */

use std::io;

namespace http;

internal const usize FILE_READ = 65536;

// most of a file one sendfile call sends; the server's stopping is looked at between them
internal const uint64 FILE_CHUNK = 1048576;

public struct Response
{
    public int32 $status;
    public Headers $headers = Headers();
    public string $body;

    internal bool $streaming = false;

    // a stream's declared length, or -1 when the stream decides as it goes
    internal int64 $length = -1;
    internal function<void(Writer)>? $stream = null;

    // a websocket upgrade's hooks and subprotocol, and the request as routed,
    // params filled, which the Socket keeps
    internal Upgrade? $upgrade = null;
    internal Request? $origin = null;

    // a tunnel's callback, which takes the connection over raw
    internal function<void(RawConn)>? $tunnel = null;

    // a handoff's callback, which runs on the worker and may take the fd
    internal function<void(Handoff)>? $handoff = null;

    // the open file of `Response(file:)`, which goes out with sendfile(2)
    // where there is one. `$stream` reads and writes it where there is not
    internal io::file? $file = null;

    public constructor(int32 $status, const string& $body)
    {
        $this->status = $status;
        $this->body = $body;
    }

    public constructor(ok: const string& $body)
    {
        $this->status = 200;
        $this->body = $body;
    }

    public constructor(text: const string& $body)
    {
        $this->status = 200;
        $this->headers->set('Content-Type', 'text/plain; charset=utf-8');
        $this->body = $body;
    }

    public constructor(json: const string& $body)
    {
        $this->status = 200;
        $this->headers->set('Content-Type', 'application/json');
        $this->body = $body;
    }

    public constructor(html: const string& $body)
    {
        $this->status = 200;
        $this->headers->set('Content-Type', 'text/html; charset=utf-8');
        $this->body = $body;
    }

    /**
     * 200 whose body `$fn` writes as it goes. HTTP/1.1 sends it chunked.
     */
    public constructor(stream: function<void(Writer)> $fn)
    {
        $this->status = 200;
        $this->body = '';
        $this->streaming = true;
        $this->stream = $fn;
    }

    /**
     * 200 whose body `$fn` writes, exactly `$length` bytes. Extra is
     * dropped; short closes the connection.
     */
    public constructor(stream: function<void(Writer)> $fn, length: usize $length)
    {
        $this->status = 200;
        $this->body = '';
        $this->streaming = true;
        $this->length = $length as int64;
        $this->stream = $fn;
    }

    /**
     * Upgrade to a websocket on `$channel`. A bad handshake gets 426 or
     * 400, no hooks. Extra headers on this response go out with the 101.
     * `protocol` is echoed only if the client offered it.
     */
    public constructor(websocket: Channel $channel, protocol: string $name = '')
    {
        $this->upgrade = Upgrade($channel, $name);
        $this->status = 101;
        $this->body = '';
    }

    /**
     * Take the connection over raw: `$fn` gets it on a thread of its
     * own and writes everything, the head of the answer included, so a
     * proxy can pass an upstream's 101 through. Nothing of this response
     * is sent, its status and headers included. See "Tunnels" in the
     * README.
     *
     * Superseded by `Response(handoff:)`, which spawns no thread and can
     * give the connection back for keep-alive. Kept as it was for callers
     * that want a blocking thread per connection.
     */
    public constructor(tunnel: function<void(RawConn)> $fn)
    {
        $this->status = 101;
        $this->body = '';
        $this->tunnel = $fn;
    }

    /**
     * Hand the connection to `$fn` on the worker, inline, with nothing
     * written. `$fn` calls `take()` to own the fd from then on, and later
     * `resume` to give it back for the next request. One that returns
     * without taking leaves the connection to libhttp, which closes it.
     * The status and body here are never sent; the headers, as the
     * middleware left them, reach `$fn` as `Handoff::headers`. See
     * "Handoff" in the README.
     */
    public constructor(handoff: function<void(Handoff)> $fn)
    {
        $this->status = 101;
        $this->body = '';
        $this->handoff = $fn;
    }

    /**
     * File at `$path`, streamed. Missing is 404, unreadable 403. Path is
     * used as given: keeping `..` out is the handler's job.
     */
    public constructor(file: const string& $path)
    {
        result<FileBody, int32> $opened = openFile($path);
        int32 $code = 200;
        string $text = '';
        string $type = mimeOf($path);
        int64 $size = -1;
        function<void(Writer)>? $fn = null;
        io::file? $handle = null;

        if ($opened->failed()) {
            $code = $opened->failure();
            $text = reason($code);
            $type = 'text/plain; charset=utf-8';
        } else {
            FileBody $found = $opened->unwrap();
            io::file $f = $found->file;

            $size = $found->size;
            $handle = $f;
            $fn = function(Writer $w) : void {
                sendFile($f, $w);
            };
        }

        $this->status = $code;
        $this->body = $text;
        $this->streaming = $size >= 0;
        $this->length = $size;
        $this->stream = $fn;
        $this->file = $handle;
        $this->headers->set('Content-Type', $type);
    }

    public static function notFound() : Response
    {
        return errorResponse(404, 'Not Found');
    }

    public static function badRequest() : Response
    {
        return errorResponse(400, 'Bad Request');
    }

    public static function noContent() : Response
    {
        return Response(204, '');
    }

    /**
     * Replaces any header of this name.
     */
    public function header(const string& $name, const string& $value) : void
    {
        $this->headers->set($name, $value);
    }

    /**
     * 2xx.
     */
    public const function success() : bool
    {
        return $this->status >= 200 && $this->status <= 299;
    }

    /**
     * 4xx.
     */
    public const function clientError() : bool
    {
        return $this->status >= 400 && $this->status <= 499;
    }

    /**
     * Whether the body is a stream rather than `$body`.
     */
    public const function streamed() : bool
    {
        return $this->streaming;
    }

    /**
     * Whether this response hands the connection over raw.
     */
    public const function tunnels() : bool
    {
        return $this->tunnel != null;
    }

    /**
     * Whether this response hands the connection to a `Handoff` callback.
     */
    public const function hands() : bool
    {
        return $this->handoff != null;
    }

    /**
     * Whether this response upgrades the connection to a websocket.
     */
    public const function upgrades() : bool
    {
        return $this->upgrade != null;
    }

    /**
     * 5xx.
     */
    public const function serverError() : bool
    {
        return $this->status >= 500 && $this->status <= 599;
    }
}

/**
 * What a websocket response upgrades to.
 */
internal struct Upgrade
{
    public Channel $channel;
    public string $protocol;
}

/**
 * An open file and how long it is.
 */
internal struct FileBody
{
    public io::file $file;
    public int64 $size;
}

/**
 * Open a file to serve, or the status to send instead. Directories and
 * paths with a NUL are refused here, before the head promises a length.
 */
internal function openFile(const string& $path) : result<FileBody, int32>
{
    // the C side would stop at a NUL and open a different file than the
    // one the extension and the handler's checks were about
    if ($path->find("\u{0}") < $path->size()) {
        return .error(404);
    }

    if (std::fs::opendir($path)->has_value()) {
        return .error(404);
    }

    io::file $f = guard std::fs::open($path, .read) else ($e) {
        return .error(fileStatus($e));
    }

    int64 $size = guard $f->size() else ($e) {
        return .error(fileStatus($e));
    }

    return .ok(FileBody($f, $size));
}

/**
 * The status a file that could not be opened answers with.
 */
internal function fileStatus(const io::ioerror& $e) : int32
{
    if ($e->missing()) {
        return 404;
    }

    if ($e->denied()) {
        return 403;
    }

    return 500;
}

/**
 * The first `$size` bytes of `$f` onto the blocking `$sock` in the
 * kernel, in FILE_CHUNK steps, under the socket's send timeout as any
 * blocking write.
 */
internal function sendFileTo(int32 $sock, const io::file& $f, uint64 $size, const Shared& $shared) : Sent
{
    uint64 $at = 0;

    // full on a blocking socket is its send timeout
    return match (sendFileRun($sock, $f->fd(), $at, $size, $shared)) {
        FileRun::done => .done,
        FileRun::unsupported => .unsupported,
        else => .failed,
    };
}

/**
 * How a run of sendfile steps ended.
 */
internal enum FileRun
{
    // every byte up to the end went
    case done;

    // the socket took nothing more: non-blocking and full, or blocking and
    // past its send timeout
    case full;

    // the client is gone, the file ended before its length, or the server
    // is stopping, as Writer::open() tells the read loop
    case failed;

    // sendfile cannot serve this file, and nothing went yet: copy instead
    case unsupported;
}

/**
 * sendfile `$src` onto `$sock` from `$at` up to `$end`, in FILE_CHUNK
 * steps, until it is all out or the socket takes no more. `$at` moves
 * with what went. The one loop the blocking worker, the worker trying
 * without blocking, and the worker a reactor hands a file back to share.
 */
internal function sendFileRun(int32 $sock, int32 $src, uint64& $at, uint64 $end, const Shared& $shared) : FileRun
{
    while ($at < $end) {
        if ($shared->stopping->load()) {
            return .failed;
        }

        isize $put = sendFileStep($sock, $src, $at, $end);

        if ($put == RECV_AGAIN) {
            return .full;
        }

        // mid-file it is a failure: the head promised every byte
        if ($put == SENDFILE_NONE && $at == 0) {
            return .unsupported;
        }

        // 0 is a file that ended before its length: the body falls short
        if ($put <= 0) {
            return .failed;
        }

        $at = $at + ($put as uint64);
    }

    return .done;
}

/**
 * One sendfile of `$src` from `$at` toward `$end`, at most FILE_CHUNK:
 * what it sent, RECV_AGAIN, SENDFILE_NONE, or below 0 on failure.
 */
internal function sendFileStep(int32 $sock, int32 $src, uint64 $at, uint64 $end) : isize
{
    uint64 $want = $end - $at;

    if ($want > FILE_CHUNK) {
        $want = FILE_CHUNK;
    }

    return http_sendfile($sock, $src, $at as int64, $want as usize);
}

internal function sendFile(io::file $f, Writer $w) : void
{
    string $chunk = '';

    while ($w->open()) {
        $chunk->clear();
        $chunk->reserve(FILE_READ);

        usize $got = guard $f->read($chunk->spare(), FILE_READ) else {
            return;
        }

        if ($got == 0) {
            return;
        }

        $chunk->commit($got);

        if (!$w->write($chunk)) {
            return;
        }
    }
}

/**
 * A Content-Type for a file name, by extension. The common web ones;
 * anything else is `application/octet-stream`.
 */
internal function mimeOf(const string& $path) : string
{
    usize $dot = $path->size();
    usize $i = $path->size();

    while ($i > 0) {
        $i = $i - 1;

        uint8 $b = $path->byte($i);

        if ($b == CH_SLASH) {
            break;
        }

        if ($b == CH_DOT) {
            $dot = $i;
            break;
        }
    }

    if ($dot >= $path->size()) {
        return 'application/octet-stream';
    }

    string $ext = str::lower($path->sub($dot + 1, $path->size() - $dot - 1));

    if ($ext == 'html' || $ext == 'htm') {
        return 'text/html; charset=utf-8';
    }

    if ($ext == 'css') {
        return 'text/css; charset=utf-8';
    }

    if ($ext == 'js' || $ext == 'mjs') {
        return 'text/javascript; charset=utf-8';
    }

    if ($ext == 'json') {
        return 'application/json';
    }

    if ($ext == 'txt') {
        return 'text/plain; charset=utf-8';
    }

    if ($ext == 'md') {
        return 'text/markdown; charset=utf-8';
    }

    if ($ext == 'xml') {
        return 'application/xml';
    }

    if ($ext == 'svg') {
        return 'image/svg+xml';
    }

    if ($ext == 'png') {
        return 'image/png';
    }

    if ($ext == 'jpg' || $ext == 'jpeg') {
        return 'image/jpeg';
    }

    if ($ext == 'gif') {
        return 'image/gif';
    }

    if ($ext == 'webp') {
        return 'image/webp';
    }

    if ($ext == 'ico') {
        return 'image/x-icon';
    }

    if ($ext == 'wasm') {
        return 'application/wasm';
    }

    if ($ext == 'pdf') {
        return 'application/pdf';
    }

    if ($ext == 'woff2') {
        return 'font/woff2';
    }

    return 'application/octet-stream';
}

internal function errorResponse(int32 $status, const string& $body) : Response
{
    Response $r = Response($status, $body);

    $r->headers->set('Content-Type', 'text/plain; charset=utf-8');
    return $r;
}
