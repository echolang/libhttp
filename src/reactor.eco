/**
 * One thread that owns every connection no worker is serving.
 *
 * It waits on the listen socket, the wake pipe, and idle or half-read
 * connections. A whole request goes to a worker. The reactor never
 * blocks on a client.
 *
 * Last-response connections linger here: write side shut, leftover
 * bytes drained, so the answer is never a reset. Open websockets sit
 * in their own map; a whole message, ping, close, or bad frame goes to
 * a worker. A pong only resets the quiet clock.
 */

use std::thread;
use std::time;

namespace http;

internal const int32 SWEEP_MS = 100;
internal const int32 PAUSE_MS = 50;
internal const int32 ACCEPT_BATCH = 64;
internal const usize EVENT_BATCH = 256;
internal const usize READ_MIN = 4096;
internal const usize READ_CHUNK = 16384;

/**
 * A connection the reactor holds: between requests, or part of the way
 * through one.
 */
internal struct Slot
{
    public string $peer;
    public Framer $framer;
    public int32 $served;
}

/**
 * A connection in its lingering close: since when, and how much of what
 * the client is still sending has been dropped.
 */
internal struct Linger
{
    public time::instant $since;
    public int64 $drained;
}

internal class Reactor
{
    private int32 $ev;
    private int32 $listenFd;
    private int32 $wakeRd;
    private Limits $limits;
    private int32 $maxConns;
    private Shared $shared;
    private JobQueue $jobs;
    private thread::receiver<Back> $back;

    // kept connections workers parked here without waking this reactor,
    // and whether this event batch already looked for one
    private Inbox $inbox;
    private bool $checked;

    // this reactor's index among the server's, which is where its
    // connections come back to, and how many new ones it accepts per wake
    private int32 $home;
    private int32 $acceptBatch;

    private map<int32, Slot> $slots;
    private map<int32, WsConn> $sockets;
    private map<int32, Linger> $lingering;
    private time::instant $swept;

    // out of descriptors: listen is disarmed until PAUSE_MS passes
    private bool $paused;
    private time::instant $pausedAt;

    public constructor(
        int32 $ev,
        int32 $listenFd,
        int32 $wakeRd,
        int32 $home,
        int32 $acceptBatch,
        Limits $limits,
        int32 $maxConns,
        Shared $shared,
        JobQueue $jobs,
        thread::receiver<Back> $back,
        Inbox $inbox
    )
    {
        $this->ev = $ev;
        $this->listenFd = $listenFd;
        $this->wakeRd = $wakeRd;
        $this->home = $home;
        $this->acceptBatch = $acceptBatch;
        $this->limits = $limits;
        $this->maxConns = $maxConns;
        $this->shared = $shared;
        $this->jobs = $jobs;
        $this->back = $back;
        $this->inbox = $inbox;
        $this->checked = false;
        $this->slots = map<int32, Slot>();
        $this->sockets = map<int32, WsConn>();
        $this->lingering = map<int32, Linger>();
        $this->swept = time::instant::now();
        $this->paused = false;
        $this->pausedAt = time::instant::now();
    }

    /**
     * Serve until `stop()`. Errors only if the listen socket itself broke.
     */
    internal function run() : status<Error>
    {
        if (http_ev_arm($this->ev, $this->listenFd, 0) != 0 || http_ev_arm($this->ev, $this->wakeRd, 0) != 0) {
            return .error(.accept(lastError()));
        }

        array<int32> $ready = arr::room<int32>(EVENT_BATCH);

        while (true) {
            int32 $wait = -1;

            // deadlines need a sweep even when nothing is readable. a
            // connection on a worker or in the inbox is in none of the maps
            // yet, and may come back here to idle out, so any live one keeps
            // the sweep going
            if (!$this->slots->empty() || !$this->sockets->empty() || !$this->lingering->empty() || $this->paused || $this->shared->live->load() > 0) {
                $wait = SWEEP_MS;
            }

            ptr<int32> $fds = $ready->spare();
            int32 $n = http_ev_wait($this->ev, $fds, $ready->room() as int32, $wait);

            if ($n < 0) {
                return .error(.accept(lastError()));
            }

            bool $woke = false;
            usize $i = 0;

            $this->checked = false;

            while ($i < ($n as usize)) {
                int32 $fd = $fds:$[$i];

                $i = $i + 1;

                if ($fd == $this->listenFd) {
                    guard $this->acceptAll() else ($e) {
                        return .error($e);
                    }

                    continue;
                }

                if ($fd == $this->wakeRd) {
                    http_drain($this->wakeRd);
                    $woke = true;
                    continue;
                }

                $this->readable($fd);
            }

            if ($woke) {
                if ($this->shared->stopping->load()) {
                    return .ok;
                }

                $this->adoptReturned();
            }

            $this->sweep();
        }
    }

    /**
     * Close every connection this reactor holds. Open websockets go to a
     * worker for 1001 and `onClose` first.
     */
    internal function shutdown() : void
    {
        array<int32> $fds = $this->slots->keys();
        usize $n = $fds->count();
        usize $i = 0;

        while ($i < $n) {
            $this->drop($fds[$i]);
            $i = $i + 1;
        }

        array<int32> $open = $this->sockets->keys();

        $n = $open->count();
        $i = 0;

        while ($i < $n) {
            $this->hand($open[$i], WsEvent::goingAway);
            $i = $i + 1;
        }

        array<int32> $closing = $this->lingering->keys();

        $n = $closing->count();
        $i = 0;

        while ($i < $n) {
            $this->unlinger($closing[$i]);
            $i = $i + 1;
        }

        closeParked($this->inbox, $this->shared);
    }

    private function acceptAll() : status<Error>
    {
        // behind is the oldest job waiting too long, not a queue a burst
        // just filled. asked once per batch: it takes the lock every worker
        // contends for
        bool $behind = $this->jobs->oldestWait() >= $this->limits->queueWait;
        int32 $round = 0;

        while ($round < $this->acceptBatch) {
            $round = $round + 1;

            string $peer = '';

            $peer->reserve(64);

            usize $room = $peer->room();
            ptr<uint8> $dst = $peer->spare();
            int32 $fd = http_accept_one($this->listenFd, $dst, $room as int32);

            if ($fd == ACCEPT_AGAIN) {
                return .ok;
            }

            if ($fd < 0) {
                if (http_is_fd_limit() != 0) {
                    // out of descriptors: stop listening a moment instead of spinning on EMFILE
                    http_ev_drop($this->ev, $this->listenFd);
                    $this->paused = true;
                    $this->pausedAt = time::instant::now();
                    return .ok;
                }

                if (http_is_badfd() != 0) {
                    return .error(.accept(lastError()));
                }

                continue;
            }

            usize $pn = 0;

            while ($pn < $room) {
                if ($dst:$[$pn] == 0) {
                    break;
                }

                $pn = $pn + 1;
            }

            $peer->commit($pn);

            if ($behind || $this->shared->live->load() >= $this->maxConns) {
                reject($fd);
                continue;
            }

            $this->shared->live->add(1);
            $this->slots[$fd] = Slot($peer, Framer(), 0);

            if (http_ev_arm($this->ev, $fd, 1) != 0) {
                $this->drop($fd);
            }
        }

        return .ok;
    }

    private function readable(int32 $fd) : void
    {
        if (!$this->slots->has($fd)) {
            if ($this->sockets->has($fd)) {
                $this->socketReadable($fd);
                return;
            }

            if ($this->lingering->has($fd)) {
                $this->lingerReadable($fd);
                return;
            }

            // parked and armed before this wait returned. still unknown
            // after one look: stale
            if ($this->checked) {
                return;
            }

            $this->checked = true;
            $this->adoptInbox();

            if (!$this->slots->has($fd)) {
                return;
            }
        }

        isize $got = recvInto($fd, $this->slots->at($fd)->framer->buffer);

        if ($got == RECV_AGAIN) {
            $this->arm($fd);
            return;
        }

        // the client closed, mid-request or not. nothing to answer
        if ($got <= 0) {
            $this->drop($fd);
            return;
        }

        $this->process($fd);
    }

    /**
     * Advance the Framer: wait for more, send the 100, or hand to a worker.
     */
    private function process(int32 $fd) : void
    {
        bool $more = true;

        while ($more) {
            $more = false;

            Step $step = $this->slots->at($fd)->framer->advance($this->limits);

            match ($step) {
                Step::needMore => {
                    $this->arm($fd);
                },
                Step::sendContinue => {
                    string $interim = 'HTTP/1.1 100 Continue\r\n\r\n';
                    isize $put = http_send_now($fd, $interim->data(), $interim->size());

                    // 25 bytes into an empty send buffer. short means the client is gone
                    if ($put != ($interim->size() as isize)) {
                        $this->drop($fd);
                    } else {
                        $more = true;
                    }
                },
                Step::ready => {
                    // the whole slot moves. the request inside it is never copied here
                    Slot $slot = $this->slots->take($fd);

                    $this->jobs->send(Job::serve(Visit($fd, $this->home, mv $slot)));
                },
                Step::fail($e) => {
                    Slot $gone = $this->slots->take($fd);

                    $this->jobs->send(Job::fail($fd, $this->home, $e));
                },
            }
        }
    }

    private function adoptReturned() : void
    {
        while (true) {
            thread::poll<Back> $p = $this->back->try_recv();

            match ($p) {
                thread::poll<Back>::item($returned) => {
                    match ($returned) {
                        Back::kept($parked) => {
                            $this->adopt($parked);
                        },
                        Back::socket($ws) => {
                            $this->adoptSocket($ws);
                        },
                        Back::linger($fd) => {
                            $this->lingering[$fd] = Linger(time::instant::now(), 0);

                            if (http_ev_arm($this->ev, $fd, 1) != 0) {
                                $this->unlinger($fd);
                            }
                        },
                        Back::rearm($fd) => {
                            if ($this->slots->has($fd)) {
                                $this->arm($fd);
                            }
                        },
                    }
                },
                else => {
                    return;
                },
            }
        }
    }

    /**
     * Drain a lingering connection. Closes on hangup, or once it has sent
     * more than a client with nothing left would.
     */
    private function lingerReadable(int32 $fd) : void
    {
        int64 $got = http_drain_now($fd);

        if ($got < 0) {
            $this->unlinger($fd);
            return;
        }

        Linger& $l = $this->lingering->at($fd);

        $l->drained = $l->drained + $got;

        if ($l->drained > LINGER_CAP || http_ev_arm($this->ev, $fd, 1) != 0) {
            $this->unlinger($fd);
        }
    }

    private function unlinger(int32 $fd) : void
    {
        if (!$this->lingering->remove($fd)) {
            return;
        }

        http_close($fd);
        $this->shared->live->sub(1);
    }

    /**
     * Adopt parked connections. Each fd is already armed; this only gives
     * it a slot.
     */
    private function adoptInbox() : void
    {
        array<Parked> $parked = $this->inbox->takeAll();

        while (!$parked->empty()) {
            $this->slotFor($parked->pop());
        }
    }

    /**
     * A kept connection with bytes already buffered, so it goes straight to
     * processing. One with none is parked through the inbox instead.
     */
    private function adopt(Parked $parked) : void
    {
        $this->slotFor($parked);
        $this->process($parked->fd);
    }

    private function slotFor(const Parked& $parked) : void
    {
        $this->slots[$parked->fd] = Slot($parked->peer, Framer($parked->rest), $parked->served);
    }

    private function adoptSocket(WsConn $ws) : void
    {
        int32 $fd = $ws->fd;
        bool $pending = !$ws->reader->buffer->empty();

        $this->sockets[$fd] = $ws;

        // frames behind the last one never make the socket readable again
        if ($pending) {
            $this->socketProcess($fd);
            return;
        }

        $this->armSocket($fd);
    }

    private function socketReadable(int32 $fd) : void
    {
        isize $got = 0;

        {
            WsConn& $ws = $this->sockets->at($fd);

            $got = recvInto($fd, $ws->reader->buffer);

            if ($got > 0) {
                $ws->hear();
            }
        }

        if ($got == RECV_AGAIN) {
            $this->armSocket($fd);
            return;
        }

        // the client went away without a close frame. 1006, and onClose runs
        if ($got <= 0) {
            $this->hand($fd, WsEvent::gone);
            return;
        }

        $this->socketProcess($fd);
    }

    /**
     * Decode buffered frames. Hand a worker the first thing that needs
     * one. A pong needs nothing; decoding continues past it.
     */
    private function socketProcess(int32 $fd) : void
    {
        while (true) {
            WsStep $step = $this->sockets->at($fd)->reader->advance($this->limits->maxMessage);

            match ($step) {
                WsStep::needMore => {
                    $this->armSocket($fd);
                    return;
                },
                WsStep::pong => {
                },
                WsStep::message($m) => {
                    $this->hand($fd, WsEvent::message($m));
                    return;
                },
                WsStep::ping($payload) => {
                    $this->hand($fd, WsEvent::ping($payload));
                    return;
                },
                WsStep::close($code, $reason) => {
                    $this->hand($fd, WsEvent::close($code, $reason));
                    return;
                },
                WsStep::fail($code) => {
                    $this->hand($fd, WsEvent::fail($code));
                    return;
                },
            }
        }
    }

    /**
     * Take the socket off this reactor and give a worker `$event`.
     */
    private function hand(int32 $fd, WsEvent $event) : void
    {
        WsConn $ws = $this->sockets->take($fd);

        $this->jobs->send(Job::ws(mv $ws, $event));
    }

    private function armSocket(int32 $fd) : void
    {
        if (http_ev_arm($this->ev, $fd, 1) != 0) {
            $this->hand($fd, WsEvent::gone);
        }
    }

    /**
     * Drop idle connections, 408 slow requests, ping quiet websockets.
     */
    private function sweep() : void
    {
        if ($this->paused && $this->pausedAt->elapsed() >= time::duration::millis(PAUSE_MS)) {
            $this->paused = false;
            http_ev_arm($this->ev, $this->listenFd, 0);
        }

        if ($this->swept->elapsed() < time::duration::millis(SWEEP_MS)) {
            return;
        }

        $this->swept = time::instant::now();

        // parked connections still have to idle out; they sit in the inbox
        $this->adoptInbox();

        array<int32> $fds = $this->slots->keys();
        usize $n = $fds->count();
        usize $i = 0;

        while ($i < $n) {
            int32 $fd = $fds[$i];
            Expiry $late = $this->slots->at($fd)->framer->expired($this->limits);

            $i = $i + 1;

            match ($late) {
                Expiry::none => {
                },
                Expiry::idle => {
                    $this->drop($fd);
                },
                Expiry::timeout => {
                    Slot $gone = $this->slots->take($fd);

                    // armed while it was waiting: it must not report to the
                    // reactor once a worker owns it
                    http_ev_drop($this->ev, $fd);
                    $this->jobs->send(Job::fail($fd, $this->home, .timeout));
                },
            }
        }

        array<int32> $closing = $this->lingering->keys();

        $n = $closing->count();
        $i = 0;

        while ($i < $n) {
            int32 $fd = $closing[$i];

            $i = $i + 1;

            if ($this->lingering->at($fd)->since->elapsed() >= time::duration::millis(LINGER_MS)) {
                $this->unlinger($fd);
            }
        }

        array<int32> $open = $this->sockets->keys();

        $n = $open->count();
        $i = 0;

        while ($i < $n) {
            int32 $fd = $open[$i];

            $i = $i + 1;

            WsEvent $due = guard $this->sockets->at($fd)->due($this->limits->pingInterval) else {
                continue;
            }

            // armed while it was waiting: it must not report to the reactor
            // once a worker owns it
            http_ev_drop($this->ev, $fd);
            $this->hand($fd, $due);
        }
    }

    private function arm(int32 $fd) : void
    {
        if (http_ev_arm($this->ev, $fd, 1) != 0) {
            $this->drop($fd);
        }
    }

    /**
     * Plain close, no answer owed. Also drops the fd from the event set.
     */
    private function drop(int32 $fd) : void
    {
        if (!$this->slots->remove($fd)) {
            return;
        }

        http_close($fd);
        $this->shared->live->sub(1);
    }
}

/**
 * After workers join: close anything handed back on the way out.
 */
internal function drainReturned(thread::receiver<Back> $back, Inbox $inbox, Shared $shared) : void
{
    // parked after this reactor's shutdown looked. still has to close
    closeParked($inbox, $shared);

    while (true) {
        thread::poll<Back> $p = $back->try_recv();

        match ($p) {
            thread::poll<Back>::item($returned) => {
                match ($returned) {
                    Back::kept($parked) => {
                        http_close($parked->fd);
                        $shared->live->sub(1);
                    },
                    Back::linger($fd) => {
                        http_close($fd);
                        $shared->live->sub(1);
                    },
                    Back::socket($ws) => {
                        // no worker left; onClose still has to run once
                        goAway($ws, $shared);
                    },
                    Back::rearm($fd) => {
                        // the slot it names was closed with the rest. nothing to rearm
                    },
                }
            },
            else => {
                return;
            },
        }
    }
}

/**
 * Close every connection parked on `$inbox`. Taken under the lock, so
 * it closes once.
 */
internal function closeParked(Inbox $inbox, Shared $shared) : void
{
    array<Parked> $parked = $inbox->takeAll();

    while (!$parked->empty()) {
        Parked $p = $parked->pop();

        http_close($p->fd);
        $shared->live->sub(1);
    }
}

/**
 * One read onto `$buf`, grown first if nearly full. Count, `RECV_AGAIN`,
 * or the end.
 */
internal function recvInto(int32 $fd, string& $buf) : isize
{
    if ($buf->room() < READ_MIN) {
        $buf->reserve($buf->size() + READ_CHUNK);
    }

    usize $room = $buf->room();
    ptr<uint8> $dst = $buf->spare();
    isize $got = http_recv_now($fd, $dst, $room);

    if ($got > 0) {
        $buf->commit($got as usize);
    }

    return $got;
}

/**
 * 503 when the server is full. Plain close: lingering would stall
 * everyone else.
 */
internal function reject(int32 $fd) : void
{
    Response $r = errorResponse(503, 'Service Unavailable');

    $r->headers->set('Retry-After', '1');

    string $bytes = render($r, true);

    http_send_now($fd, $bytes->data(), $bytes->size());
    http_close($fd);
}
