/**
 * One incoming request, as a value.
 *
 * Parsed once, handed to one handler by value. `$params` is filled by
 * the router, just before the handler runs.
 */

namespace http;

public struct Request
{
    public Method $method;
    public string $target;
    public string $path;
    public string $queryString;
    public Query $query;
    public string $version;
    public Headers $headers;
    public string $body;
    public string $peer;
    public map<string, string> $params;

    public constructor(
        Method $method,
        const string& $target,
        const string& $path,
        const string& $queryString,
        Query $query,
        const string& $version,
        Headers $headers,
        const string& $body,
        const string& $peer
    )
    {
        $this->method = $method;
        $this->target = $target;
        $this->path = $path;
        $this->queryString = $queryString;
        $this->query = $query;
        $this->version = $version;
        $this->headers = $headers;
        $this->body = $body;
        $this->peer = $peer;
        $this->params = map<string, string>();
    }

    /**
     * The first header of this name, or nothing. Case-insensitive.
     */
    public const function header(const string& $name) : string?
    {
        return $this->headers->get($name);
    }

    /**
     * True if this is a well-formed websocket upgrade. Lets one route
     * answer both a page and its socket.
     */
    public const function websocket() : bool
    {
        return !upgradeKey($this)->failed();
    }

    /**
     * A captured route param, or nothing. `{name?}` missing is nothing;
     * `{name*}` is always there, `''` if the path ended at it.
     */
    public const function param(const string& $name) : string?
    {
        if (!$this->params->has($name)) {
            return null;
        }

        return $this->params->get($name);
    }

}
