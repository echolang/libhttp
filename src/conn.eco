/**
 * An owned socket. Closes on drop.
 *
 * A class so `result<Conn, Error>` can hand one back without a move.
 */

use std::thread;

namespace http;

internal class Conn
{
    private int32 $fd;

    public constructor(int32 $fd)
    {
        $this->fd = $fd;
    }

    destructor()
    {
        if ($this->fd >= 0) {
            http_close($this->fd);
            $this->fd = -1;
        }
    }

    internal static function dial(const string& $host, int32 $port) : result<Conn, Error>
    {
        $name = cstrOf($host);
        int32 $fd = http_connect($name->cstr(), $port);

        if ($fd < 0) {
            return .error(.connect(lastError()));
        }

        return .ok(Conn($fd));
    }

    /**
     * Hands the fd to someone else. This Conn no longer closes it.
     */
    internal function release() : int32
    {
        int32 $fd = $this->fd;

        $this->fd = -1;
        return $fd;
    }

    /**
     * Linger-close: shut write, drain a moment, close. So the response
     * survives a client that still had something to say.
     */
    internal function finish() : void
    {
        if ($this->fd >= 0) {
            http_finish($this->fd);
            $this->fd = -1;
        }
    }

    /**
     * The fd, still owned by this Conn. -1 once released.
     */
    internal const function fd() : int32
    {
        return $this->fd;
    }

    internal function recv(ptr<uint8> $buf, usize $n) : isize
    {
        if ($this->fd < 0) {
            return -1;
        }

        return http_recv($this->fd, $buf, $n);
    }

    internal function writeAll(const string& $bytes) : bool
    {
        return $this->fd >= 0 && sendAll($this->fd, $bytes);
    }

    internal function readAll(usize $cap) : string
    {
        string $out = '';

        $out->reserve($cap);

        while ($out->size() < $cap) {
            if ($out->room() == 0) {
                $out->reserve($out->size() + 4096);
            }

            usize $room = $out->room();
            ptr<uint8> $dst = $out->spare();
            isize $got = $this->recv($dst, $room);

            if ($got <= 0) {
                return $out;
            }

            $out->commit($got as usize);
        }

        return $out;
    }
}

internal function cstrOf(const string& $s) : string
{
    if ($s->terminated()) {
        return $s;
    }

    return $s->clone();
}

/**
 * Non-blocking sends of `$bytes` from `$from` until they are all out or the
 * socket is full. How far they got, or -1 once a send failed.
 */
internal function sendNow(int32 $fd, const string& $bytes, usize $from) : isize
{
    usize $at = $from;
    usize $n = $bytes->size();
    $p = $bytes->data();

    while ($at < $n) {
        isize $put = http_send_now($fd, $p:$ + $at, $n - $at);

        if ($put == RECV_AGAIN) {
            break;
        }

        if ($put <= 0) {
            return -1;
        }

        $at = $at + ($put as usize);
    }

    return $at as isize;
}

/**
 * Blocking sends of `$bytes` from `$from` up to `$to`, or until one fails.
 */
internal function sendRange(int32 $fd, const string& $bytes, usize $from, usize $to) : bool
{
    usize $at = $from;
    $p = $bytes->data();

    while ($at < $to) {
        isize $put = http_send($fd, $p:$ + $at, $to - $at);

        if ($put <= 0) {
            return false;
        }

        $at = $at + ($put as usize);
    }

    return true;
}

/**
 * Blocking sends until `$bytes` are all out, or one fails.
 */
internal function sendAll(int32 $fd, const string& $bytes) : bool
{
    return sendRange($fd, $bytes, 0, $bytes->size());
}

/**
 * The sending side of a connection any thread may write to: an open
 * websocket, an event stream. The fd is locked, so writes from two threads
 * never interleave, and only the connection's owner takes it, so a
 * broadcast never writes a recycled descriptor.
 */
#[atomic]
internal class Wire
{
    private thread::mutex<int32> $fd;

    // the protocol's last word went out. nothing but control may follow it
    private atomic<bool> $closing;

    // a send failed. the client is gone or stopped reading
    private atomic<bool> $broken;

    // taken: the connection is closed or about to be
    private atomic<bool> $ended;

    public constructor(int32 $fd)
    {
        $this->fd = thread::mutex<int32>($fd);
        $this->closing = atomic<bool>(false);
        $this->broken = atomic<bool>(false);
        $this->ended = atomic<bool>(false);
    }

    /**
     * Marks it closing. True only the first time, for the one caller that
     * sends the last word.
     */
    public function shut() : bool
    {
        return !$this->closing->exchange(true);
    }

    public const function closing() : bool
    {
        return $this->closing->load();
    }

    public const function broken() : bool
    {
        return $this->broken->load();
    }

    public const function ended() : bool
    {
        return $this->ended->load();
    }

    /**
     * Bytes onto the wire, unless it is closing.
     */
    public function deliver(const string& $bytes) : bool
    {
        return !$this->closing->load() && $this->write($bytes);
    }

    /**
     * Bytes onto the wire, closing or not, under the lock.
     */
    public function write(const string& $bytes) : bool
    {
        thread::locked<int32> $held = $this->fd->lock();

        if ($held->value < 0) {
            return false;
        }

        if (!sendAll($held->value, $bytes)) {
            $this->broken->store(true);
            return false;
        }

        return true;
    }

    /**
     * Closes the connection with a lingering close. Only the connection's
     * owner calls this, once; every send after it answers false.
     */
    public function release() : void
    {
        // the lingering close can wait seconds: it happens outside the lock,
        // so a broadcast never waits on it
        int32 $fd = $this->take();

        if ($fd >= 0) {
            http_finish($fd);
        }
    }

    /**
     * Takes the descriptor for the caller to close. Only the connection's
     * owner calls this, once; every send after it answers false. -1 when
     * it was already taken.
     */
    public function take() : int32
    {
        thread::locked<int32> $held = $this->fd->lock();
        int32 $fd = $held->value;

        $held->value = -1;
        $this->ended->store(true);
        return $fd;
    }
}
