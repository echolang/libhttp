/**
 * Case-insensitive header list. Duplicates kept, arrival order.
 *
 * An array, not a map: HTTP repeats Set-Cookie.
 */

namespace http;

public struct Header
{
    public string $name;
    public string $value;
}

public struct Headers
{
    /**
     * In arrival order, duplicates kept.
     */
    public array<Header> $items;

    public constructor()
    {
        $this->items = array<Header>();
    }

    public const function count() : usize
    {
        return $this->items->count();
    }

    public const function empty() : bool
    {
        return $this->items->empty();
    }

    /**
     * Appends, keeping any header of the same name that is already here.
     */
    public function add(const string& $name, const string& $value) : void
    {
        $this->items[] = Header($name, $value);
    }

    /**
     * Replaces every header of this name, or appends when there is none.
     */
    public function set(const string& $name, const string& $value) : void
    {
        $this->remove($name);
        $this->add($name, $value);
    }

    /**
     * Drops every header of this name. Walked backwards so a remove does
     * not skip the next one.
     */
    public function remove(const string& $name) : usize
    {
        usize $dropped = 0;
        usize $i = $this->items->count();

        while ($i > 0) {
            $i = $i - 1;

            if (str::iequals($this->items[$i]->name->view(), $name->view())) {
                Header $gone = $this->items->remove($i);

                $dropped = $dropped + 1;
            }
        }

        return $dropped;
    }

    /**
     * The first header of this name, or nothing. Case-insensitive, the way HTTP is.
     */
    public const function get(const string& $name) : string?
    {
        usize $count = $this->items->count();
        usize $i = 0;

        while ($i < $count) {
            if (str::iequals($this->items[$i]->name->view(), $name->view())) {
                string $value = $this->items[$i]->value;

                return $value;
            }

            $i = $i + 1;
        }

        return null;
    }

    /**
     * Every header of this name, in arrival order.
     */
    public const function all(const string& $name) : array<string>
    {
        array<string> $found = array<string>();
        usize $count = $this->items->count();
        usize $i = 0;

        while ($i < $count) {
            if (str::iequals($this->items[$i]->name->view(), $name->view())) {
                $found[] = $this->items[$i]->value;
            }

            $i = $i + 1;
        }

        return $found;
    }

    /**
     * How many headers of this name there are. `all` without building the
     * list, for a check that only counts.
     */
    internal const function countOf(const string& $name) : usize
    {
        usize $found = 0;
        usize $count = $this->items->count();
        usize $i = 0;

        while ($i < $count) {
            if (str::iequals($this->items[$i]->name->view(), $name->view())) {
                $found = $found + 1;
            }

            $i = $i + 1;
        }

        return $found;
    }

    public const function has(const string& $name) : bool
    {
        return $this->get($name) != null;
    }

    public function clear() : void
    {
        $this->items->clear();
    }
}

/**
 * RFC 9110 token: letters, digits, `!#$%&'*+-.^_`|~`. A header name is
 * one, so a space or colon in a name is refused.
 */
internal function isToken(const string& $s) : bool
{
    usize $n = $s->size();
    usize $i = 0;

    if ($n == 0) {
        return false;
    }

    while ($i < $n) {
        if (!tokenByte($s->byte($i))) {
            return false;
        }

        $i = $i + 1;
    }

    return true;
}

private function tokenByte(uint8 $b) : bool
{
    if (($b >= CH_ZERO && $b <= CH_NINE) || ($b >= CH_UPPER_A && $b <= CH_UPPER_Z) || ($b >= CH_LOWER_A && $b <= CH_LOWER_Z)) {
        return true;
    }

    string $marks = "!#$%&'*+-.^_`|~";
    usize $i = 0;

    while ($i < $marks->size()) {
        if ($marks->byte($i) == $b) {
            return true;
        }

        $i = $i + 1;
    }

    return false;
}

/**
 * Header lines from a request block. Folds join onto the header above.
 * No colon, a fold with nothing above, or CR/NUL in a value is a 400.
 */
internal function parseHeaderBlock(const string& $raw) : result<Headers, WireError>
{
    Headers $out = Headers();
    usize $n = $raw->size();
    usize $start = 0;

    string $pendingName = '';
    string $pendingValue = '';
    bool $pending = false;

    // one walk over the block. Names and values are slices of it, not copies:
    // a copy is two allocations for anything past fifteen bytes
    while ($start < $n) {
        usize $from = $start;
        usize $end = $raw->find('\n', $from);

        $start = $end + 1;

        // a window, so the trim copies nothing. a CRLF line ends at its CR
        $end = $from + str::rtrim($raw->view()->sub($from, $end - $from))->size;

        if ($end == $from) {
            continue;
        }

        uint8 $first = $raw->byte($from);

        if ($first == CH_SPACE || $first == CH_TAB) {
            // whitespace before the first header is how one hop sees a
            // header another one skips
            if (!$pending) {
                return .error(.badRequest);
            }

            $folded = str::from(str::trim($raw->sub($from, $end - $from)));

            if (!headerSafe($folded)) {
                return .error(.badRequest);
            }

            $pendingValue = "{$pendingValue} {$folded}";
            continue;
        }

        if ($pending) {
            $out->add($pendingName, $pendingValue);
            $pending = false;
        }

        usize $at = $raw->find(':', $from);

        if ($at >= $end) {
            return .error(.badRequest);
        }

        $pendingName = $raw->sub($from, $at - $from);

        if (!isToken($pendingName)) {
            return .error(.badRequest);
        }

        $pendingValue = str::ltrim($raw->sub($at + 1, $end - $at - 1));

        if (!headerSafe($pendingValue)) {
            return .error(.badRequest);
        }

        $pending = true;
    }

    if ($pending) {
        $out->add($pendingName, $pendingValue);
    }

    return .ok($out);
}
