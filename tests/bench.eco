/**
 * Router throughput. Not a correctness test: it asserts nothing, since a
 * release build drops `assert`. Compiled only with the `bench` flag:
 *
 *     echoc test --release --optimize whole --define bench --filter group:bench --verbose
 *
 * `--optimize whole` or the numbers measure call overhead: under the default,
 * nothing from the stdlib inlines here. See ECHOCBUGS.md.
 *
 * Each shape runs what `dispatch` runs before the handler: split and decode
 * the path, find the route, then capture params or build `Allow` on a miss.
 */

#[if: bench]

use std::time;

internal const usize BENCH_ROUNDS = 1000000;

internal function benchHandler() : function<http::Response(http::Request)>
{
    return function(http::Request $req) : http::Response {
        return http::Response(ok: 'x');
    };
}

internal function benchTable() : array<http::Route>
{
    array<http::Route> $t = array<http::Route>();
    $h = benchHandler();

    $t[] = http::Route(http::Method::get, '/', $h);
    $t[] = http::Route(http::Method::get, '/health', $h);
    $t[] = http::Route(http::Method::get, '/metrics', $h);
    $t[] = http::Route(http::Method::get, '/login', $h);
    $t[] = http::Route(http::Method::post, '/login', $h);
    $t[] = http::Route(http::Method::post, '/logout', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/users', $h);
    $t[] = http::Route(http::Method::post, '/api/v1/users', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/users/{id}', $h);
    $t[] = http::Route(http::Method::put, '/api/v1/users/{id}', $h);
    $t[] = http::Route(http::Method::delete, '/api/v1/users/{id}', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/users/{id}/posts', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/users/{id}/posts/{post}', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/users/{id}/followers', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/posts', $h);
    $t[] = http::Route(http::Method::post, '/api/v1/posts', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/posts/{id}', $h);
    $t[] = http::Route(http::Method::patch, '/api/v1/posts/{id}', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/posts/{id}/comments', $h);
    $t[] = http::Route(http::Method::post, '/api/v1/posts/{id}/comments', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/comments/{id}', $h);
    $t[] = http::Route(http::Method::delete, '/api/v1/comments/{id}', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/tags', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/tags/{tag}/posts', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/search', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/orgs', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/orgs/{org}', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/orgs/{org}/teams', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/orgs/{org}/teams/{team}', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/orgs/{org}/teams/{team}/members', $h);
    $t[] = http::Route(http::Method::get, '/api/v2/users/{id}', $h);
    $t[] = http::Route(http::Method::get, '/api/v2/posts/{id}', $h);
    $t[] = http::Route(http::Method::get, '/admin', $h);
    $t[] = http::Route(http::Method::get, '/admin/users', $h);
    $t[] = http::Route(http::Method::get, '/admin/users/{id}', $h);
    $t[] = http::Route(http::Method::get, '/admin/settings', $h);
    $t[] = http::Route(http::Method::get, '/files/{name}', $h);
    $t[] = http::Route(http::Method::get, '/docs/{page}', $h);
    $t[] = http::Route(http::Method::get, '/blog/{year}/{month}/{slug}', $h);
    $t[] = http::Route(http::Method::get, '/static/{file}', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/items/{id:number}', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/orders/{id:uuid}', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/feed/{page?:number}', $h);
    $t[] = http::Route(http::Method::get, '/api/v1/posts/{state:draft|live|archived}/list', $h);
    $t[] = http::Route(http::Method::get, '/assets/{path*}', $h);

    return $t;
}

/**
 * One request's worth of routing. The returned number only exists so the
 * optimizer cannot drop the work.
 */
internal function benchOnce(const http::Router& $router, http::Request& $req) : usize
{
    array<string> $path = http::segments($req->path);

    usize $at = guard $router->find($req->method, $path) else {
        return $router->allow($path)->size();
    }

    http::applyParams($req, $router->routes[$at], $path);
    return $at + $req->params->count();
}

internal function benchShape(const http::Router& $table, const string& $label, http::Method $method, const string& $path) : void
{
    http::Request $req = http::Request($method, $path, $path, '', http::Query(), 'HTTP/1.1', http::Headers(), '', '');
    usize $sink = 0;
    usize $i = 0;

    // warm the caches and the allocator before timing
    while ($i < 10000) {
        $sink = $sink + benchOnce($table, $req);
        $i = $i + 1;
    }

    time::instant $start = time::instant::now();

    $i = 0;

    while ($i < BENCH_ROUNDS) {
        $sink = $sink + benchOnce($table, $req);
        $i = $i + 1;
    }

    int64 $ns = $start->elapsed()->as_nanos();
    int64 $per = $ns / (BENCH_ROUNDS as int64);

    echo "{$label}: {$per} ns/op  (sink {$sink})";
}

#[group: "bench"]
test router_throughput {
    array<http::Route> $routes = benchTable();
    http::Router $table = http::Router(mv $routes);

    benchShape($table, 'static first     GET /', http::Method::get, '/');
    benchShape($table, 'static early     GET /health', http::Method::get, '/health');
    benchShape($table, 'param 4 deep     GET /api/v1/users/42', http::Method::get, '/api/v1/users/42');
    benchShape($table, 'param 6 deep     GET /api/v1/users/42/posts/7', http::Method::get, '/api/v1/users/42/posts/7');
    benchShape($table, 'param late       GET /api/v1/orgs/acme/teams/core/members', http::Method::get, '/api/v1/orgs/acme/teams/core/members');
    benchShape($table, 'param last       GET /static/app.js', http::Method::get, '/static/app.js');
    benchShape($table, 'encoded param    GET /files/a%20b.txt', http::Method::get, '/files/a%20b.txt');
    benchShape($table, 'head fallback    HEAD /api/v1/posts/9', http::Method::head, '/api/v1/posts/9');
    benchShape($table, 'number           GET /api/v1/items/12345', http::Method::get, '/api/v1/items/12345');
    benchShape($table, 'uuid             GET /api/v1/orders/<uuid>', http::Method::get, '/api/v1/orders/123e4567-e89b-12d3-a456-426614174000');
    benchShape($table, 'optional absent  GET /api/v1/feed', http::Method::get, '/api/v1/feed');
    benchShape($table, 'optional present GET /api/v1/feed/3', http::Method::get, '/api/v1/feed/3');
    benchShape($table, 'one-of           GET /api/v1/posts/live/list', http::Method::get, '/api/v1/posts/live/list');
    benchShape($table, 'catch-all 1      GET /assets/app.js', http::Method::get, '/assets/app.js');
    benchShape($table, 'catch-all 4      GET /assets/img/icons/x/logo.svg', http::Method::get, '/assets/img/icons/x/logo.svg');
    benchShape($table, 'miss 404         GET /nope/nothing/here', http::Method::get, '/nope/nothing/here');
    benchShape($table, 'miss 405         POST /api/v1/tags', http::Method::post, '/api/v1/tags');
}

#[end]
